<% disable_turbo_cache %>
<main lang="<%= I18n.locale %>" class="mx-auto w-full max-w-3xl space-y-6 py-6">
  <%= link_to t("vendor_accounts.admin_back"), admin_root_path, class: "inline-flex min-h-11 items-center font-semibold text-primary underline" %>
  <h1 class="text-3xl font-semibold text-ink"><%= t("vendor_accounts.moderation_title") %></h1>
  <p class="max-w-prose leading-7 text-quiet-note"><%= t("vendor_accounts.moderation_hint") %></p>
  <% if @accounts.empty? %><p class="text-quiet-note"><%= t("vendor_accounts.empty_queue") %></p><% end %>
  <ol class="divide-y divide-private-line">
    <% @accounts.each do |account| %>
      <li class="flex flex-wrap items-center justify-between gap-3 py-4">
        <%= link_to account.business_name, admin_vendor_account_path(account), class: "inline-flex min-h-11 items-center break-words font-semibold text-primary underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" %>
        <span class="text-sm text-quiet-note"><%= t("vendor_accounts.states.#{account.status}") %></span>
      </li>
    <% end %>
  </ol>
  <%= render "vendor_accounts/pagination", page_url: ->(page) { admin_vendor_accounts_path(page:) } %>
</main>
