<% content_for :title, t("approvals.index.title") %>
<% disable_turbo_cache %>

<main class="flex flex-1 flex-col py-4 sm:py-6">
  <div class="overflow-hidden rounded-2xl border border-private-line bg-canvas">
    <header class="border-b border-private-line px-5 py-5 sm:px-7">
      <%= link_to t("approvals.index.back"), dashboard_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:text-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
      <div class="mt-3 max-w-3xl">
        <h1 class="text-3xl font-semibold text-ink"><%= t("approvals.index.heading") %></h1>
        <p class="mt-2 text-base leading-7 text-quiet-note"><%= t("approvals.index.body") %></p>
      </div>

      <nav class="mt-6 flex gap-5 overflow-x-auto" aria-label="<%= t("approvals.tabs.label") %>">
        <% %w[pending deferred completed].each do |tab| %>
          <%= link_to t("approvals.tabs.#{tab}"), approvals_path(status: tab), aria: { current: @status == tab ? "page" : nil }, class: "min-h-11 shrink-0 border-b-2 px-1 py-3 text-sm font-semibold #{@status == tab ? "border-primary text-primary" : "border-transparent text-quiet-note hover:text-ink"}" %>
        <% end %>
      </nav>
    </header>

    <% if @approval_requests.empty? %>
      <section class="px-5 py-12 sm:px-7" aria-labelledby="approval-empty-title">
        <h2 id="approval-empty-title" class="text-xl font-semibold text-ink"><%= t("approvals.empty.#{@status}.title") %></h2>
        <p class="mt-3 max-w-2xl text-base leading-7 text-quiet-note"><%= t("approvals.empty.#{@status}.body") %></p>
        <%= link_to t("approvals.empty.action"), dashboard_path, class: "mt-5 inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-canvas hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
      </section>
    <% else %>
      <div class="grid lg:grid-cols-[19rem_minmax(0,1fr)]" data-approval-queue-layout>
        <div class="min-w-0 lg:col-start-2 lg:row-start-1" data-approval-selected-item="true">
          <%= component "approval_queue_item", item: @item, mode: params[:mode], status: @status, page: @pagy.page %>
        </div>

        <aside class="border-t border-private-line bg-surface lg:col-start-1 lg:row-start-1 lg:border-t-0 lg:border-r" aria-label="<%= t("approvals.queue.label") %>">
          <ol class="divide-y divide-private-line">
            <% @approval_requests.each do |request_record| %>
              <% rail_item = ApprovalQueue::Item.new(approval_request: request_record) %>
              <li>
                <%= link_to approvals_path(status: @status, page: @pagy.page, id: request_record.id), aria: { current: request_record == @selected_request ? "true" : nil }, class: "block px-5 py-5 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-primary #{request_record == @selected_request ? "bg-canvas" : "hover:bg-canvas"}" do %>
                  <div class="flex items-start justify-between gap-3">
                    <p class="text-sm font-semibold text-primary"><%= rail_item.type_label %></p>
                    <span class="text-xs text-quiet-note"><%= l(rail_item.created_at.in_time_zone(@owner_time_zone), format: :approval) %></span>
                  </div>
                  <h2 class="mt-2 break-words text-base font-semibold text-ink"><%= rail_item.title %></h2>
                  <p class="mt-1 text-sm text-quiet-note"><%= rail_item.relationship_name %></p>
                  <p class="mt-3 text-xs font-semibold <%= rail_item.risk_level.in?(%w[high sensitive]) ? "text-danger-ink" : "text-quiet-note" %>"><%= t("approvals.risks.#{rail_item.risk_level}") %></p>
                <% end %>
              </li>
            <% end %>
          </ol>

          <% if @pagy.last > 1 %>
            <nav class="flex items-center justify-between gap-2 border-t border-private-line px-4 py-4" aria-label="<%= t("approvals.pagination.label") %>">
              <% if @pagy.previous %>
                <%= link_to t("approvals.pagination.previous"), url_for(request.query_parameters.merge("page" => @pagy.previous)), class: "min-h-11 rounded-lg px-3 py-3 text-sm font-semibold text-primary hover:bg-canvas" %>
              <% else %><span></span><% end %>
              <span class="text-sm text-quiet-note"><%= t("approvals.pagination.page", page: @pagy.page, pages: @pagy.last) %></span>
              <% if @pagy.next %>
                <%= link_to t("approvals.pagination.next"), url_for(request.query_parameters.merge("page" => @pagy.next)), class: "min-h-11 rounded-lg px-3 py-3 text-sm font-semibold text-primary hover:bg-canvas" %>
              <% end %>
            </nav>
          <% end %>
        </aside>
      </div>
    <% end %>
  </div>
</main>
