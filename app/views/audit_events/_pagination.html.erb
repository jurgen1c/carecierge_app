<% if pagy.last > 1 %>
  <nav aria-label="<%= t('audit_events.pagination.aria_label') %>" class="flex flex-col gap-3 border-t border-stone-200 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
    <p class="text-sm text-stone-700"><%= t("audit_events.pagination.info", from: pagy.from, to: pagy.to, count: pagy.count) %></p>
    <div class="flex items-center gap-2">
      <% if pagy.previous %>
        <%= link_to t("audit_events.pagination.previous"), url_for(request.query_parameters.merge("page" => pagy.previous)), class: "inline-flex min-h-11 items-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>
      <span class="px-2 text-sm font-medium text-stone-700"><%= t("audit_events.pagination.page", page: pagy.page, pages: pagy.last) %></span>
      <% if pagy.next %>
        <%= link_to t("audit_events.pagination.next"), url_for(request.query_parameters.merge("page" => pagy.next)), class: "inline-flex min-h-11 items-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>
    </div>
  </nav>
<% end %>
