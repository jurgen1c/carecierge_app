<% disable_turbo_cache %>
<main aria-labelledby="booking-form-title" class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
  <header class="border-b border-private-line pb-5">
    <%= link_to t("bookings.form.back"), event_plan_bookings_path(@event_plan), class: "inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4" %>
    <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h1 id="booking-form-title" class="text-3xl font-semibold text-ink"><%= @booking.title %></h1>
        <p class="mt-2 max-w-2xl text-base leading-7 text-quiet-note"><%= t("bookings.edit.body") %></p>
      </div>
      <span class="inline-flex w-fit rounded-full border border-private-line bg-surface px-3 py-1 text-sm font-semibold text-ink"><%= @booking.status_label %></span>
    </div>
  </header>
  <%= render "form" %>
  <div class="border-t border-private-line py-5">
    <%= button_to t("bookings.actions.delete"), booking_path(@booking), method: :delete, class: "inline-flex min-h-11 items-center text-sm font-semibold text-danger-ink", form: { data: { turbo_confirm: t("bookings.actions.delete_confirm", title: @booking.title) } } %>
  </div>
</main>
