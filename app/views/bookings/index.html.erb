<% disable_turbo_cache %>
<main aria-labelledby="bookings-page-title" class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 lg:px-8">
  <% if @event_plan %>
    <header class="border-b border-private-line pb-6">
      <%= link_to t("bookings.index.back"), (@event_plan.archived? || @event_plan.relationship_profile.discarded? ? bookings_path : event_plan_path(@event_plan)), class: "inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4" %>
      <p class="mt-3 text-sm font-semibold text-primary"><%= @event_plan.relationship_profile.display_name %></p>
      <h1 id="bookings-page-title" class="mt-1 text-3xl font-semibold text-ink"><%= t("bookings.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-base leading-7 text-quiet-note"><%= t("bookings.index.body", plan: @event_plan.title) %></p>
    </header>

    <% unless @editable %>
      <p role="status" class="my-5 rounded-xl border border-private-line bg-surface p-4 text-sm font-semibold text-quiet-note"><%= t("bookings.index.read_only") %></p>
    <% end %>

    <%= component "booking_list", event_plan: @event_plan, bookings: @bookings, editable: @editable, show_header: false %>
  <% else %>
    <header class="border-b border-private-line pb-6">
      <%= link_to t("bookings.history.back"), event_plans_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4" %>
      <h1 id="bookings-page-title" class="mt-3 text-3xl font-semibold text-ink"><%= t("bookings.history.title") %></h1>
      <p class="mt-2 max-w-2xl text-base leading-7 text-quiet-note"><%= t("bookings.history.body") %></p>
    </header>

    <% if @bookings.any? %>
      <% @bookings.group_by(&:event_plan).each do |event_plan, bookings| %>
        <section class="border-b border-private-line py-6" aria-labelledby="booking-plan-<%= event_plan.id %>">
          <p class="text-sm font-semibold text-primary"><%= event_plan.relationship_profile.display_name %></p>
          <h2 id="booking-plan-<%= event_plan.id %>" class="mt-1 text-xl font-semibold text-ink"><%= event_plan.title %></h2>
          <%= component "booking_list",
            event_plan: event_plan,
            bookings: bookings,
            editable: event_plan.active? && event_plan.relationship_profile.kept?,
            show_header: false,
            dom_id: "bookings-#{event_plan.id}" %>
        </section>
      <% end %>
    <% else %>
      <section class="py-8" aria-labelledby="booking-history-empty-title">
        <h2 id="booking-history-empty-title" class="text-xl font-semibold text-ink"><%= t("bookings.history.empty_title") %></h2>
        <p class="mt-2 text-sm leading-6 text-quiet-note"><%= t("bookings.history.empty_body") %></p>
      </section>
    <% end %>

    <% if @pagy.last > 1 %>
      <nav aria-label="<%= t("bookings.pagination.label") %>" class="flex items-center justify-between border-t border-private-line py-5">
        <% if @pagy.previous %><%= link_to t("bookings.pagination.previous"), url_for(request.query_parameters.merge("page" => @pagy.previous)), class: "min-h-11 rounded-lg px-4 py-3 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %><% else %><span></span><% end %>
        <span class="text-sm text-quiet-note"><%= t("bookings.pagination.page", page: @pagy.page, pages: @pagy.last) %></span>
        <% if @pagy.next %><%= link_to t("bookings.pagination.next"), url_for(request.query_parameters.merge("page" => @pagy.next)), class: "min-h-11 rounded-lg px-4 py-3 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %><% end %>
      </nav>
    <% end %>
  <% end %>
</main>
