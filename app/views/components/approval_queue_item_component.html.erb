<article aria-labelledby="approval-item-title">
  <header class="border-b border-private-line px-5 py-5 sm:px-7">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-sm font-semibold text-primary"><%= item.type_label %></p>
          <span class="<%= style(:risk, level: item.risk_level.to_sym) %>"><%= t("approvals.risks.#{item.risk_level}") %></span>
        </div>
        <h2 id="approval-item-title" class="mt-2 break-words text-2xl font-semibold text-ink"><%= item.title %></h2>
        <p class="mt-2 text-sm leading-6 text-quiet-note"><%= t("approvals.detail.relationship", relationship: item.relationship_name) %></p>
      </div>
      <p class="shrink-0 text-sm text-quiet-note"><%= l(owner_local_time(item.created_at), format: :approval) %></p>
    </div>
  </header>

  <div class="grid xl:grid-cols-3">
    <section class="border-b border-private-line px-5 py-6 sm:px-7 xl:border-b-0 xl:border-r" aria-labelledby="approval-source-title">
      <div class="flex items-center gap-3">
        <span class="flex size-8 items-center justify-center rounded-full border border-private-line text-sm font-semibold text-ink" aria-hidden="true">1</span>
        <h3 id="approval-source-title" class="text-lg font-semibold text-ink"><%= t("approvals.detail.understand_source") %></h3>
      </div>
      <dl class="mt-6 space-y-5">
        <div>
          <dt class="text-sm font-semibold text-ink"><%= t("approvals.detail.source") %></dt>
          <dd class="mt-1 break-words text-sm leading-6 text-quiet-note"><%= item.source_label %></dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-ink"><%= t("approvals.detail.context") %></dt>
          <dd class="mt-1 break-words text-sm leading-6 text-quiet-note"><%= item.source_context %></dd>
        </div>
        <% if item.confidence.present? %>
          <div>
            <dt class="text-sm font-semibold text-ink"><%= t("approvals.detail.confidence") %></dt>
            <dd class="mt-1 text-sm leading-6 text-quiet-note"><%= t("approvals.confidences.#{item.confidence}") %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <section class="border-b border-private-line px-5 py-6 sm:px-7 xl:border-b-0 xl:border-r" aria-labelledby="approval-consequence-title">
      <div class="flex items-center gap-3">
        <span class="flex size-8 items-center justify-center rounded-full border border-private-line text-sm font-semibold text-ink" aria-hidden="true">2</span>
        <h3 id="approval-consequence-title" class="text-lg font-semibold text-ink"><%= t("approvals.detail.review_consequence") %></h3>
      </div>
      <div class="mt-6 space-y-6">
        <div>
          <h4 class="text-sm font-semibold text-ink"><%= t("approvals.detail.proposed_action") %></h4>
          <p class="mt-1 text-sm leading-6 text-quiet-note"><%= item.proposed_action %></p>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ink"><%= t("approvals.detail.what_will_happen") %></h4>
          <p class="mt-1 text-sm leading-6 text-quiet-note"><%= item.consequence %></p>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ink"><%= t("approvals.detail.what_will_not_happen") %></h4>
          <p class="mt-1 text-sm leading-6 text-quiet-note"><%= item.will_not_happen %></p>
        </div>
        <div>
          <h4 class="text-sm font-semibold text-ink"><%= t("approvals.detail.reversibility") %></h4>
          <p class="mt-1 text-sm leading-6 text-quiet-note"><%= item.reversible %></p>
        </div>
      </div>
    </section>

    <section class="px-5 py-6 sm:px-7" aria-labelledby="approval-decision-title">
      <div class="flex items-center gap-3">
        <span class="flex size-8 items-center justify-center rounded-full border border-private-line text-sm font-semibold text-ink" aria-hidden="true">3</span>
        <h3 id="approval-decision-title" class="text-lg font-semibold text-ink"><%= t("approvals.detail.decide") %></h3>
      </div>

      <% if approval_request.open_for_decision? %>
        <% if mode == "edit" && item.edit_supported? %>
          <%= form_with url: decision_path(mode: "edit"), method: :patch, scope: :approval_request, class: "mt-6 space-y-4" do |form| %>
            <%= form.hidden_field :decision, value: "edit" %>
            <%= form.hidden_field :lock_version, value: item.lock_version %>
            <div>
              <%= form.label :corrected_title, t("approvals.edit.title"), class: "block text-sm font-semibold text-ink" %>
              <%= form.text_field :corrected_title, value: item.corrected_title, required: true, class: "mt-2 min-h-11 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary" %>
            </div>
            <div>
              <%= form.label :corrected_body, t("approvals.edit.body"), class: "block text-sm font-semibold text-ink" %>
              <%= form.text_area :corrected_body, value: item.corrected_body, required: true, rows: 5, class: "mt-2 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-base leading-6 text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary" %>
            </div>
            <div class="flex flex-wrap gap-2">
              <%= form.submit t("approvals.actions.save_and_approve"), class: style(:button, tone: :primary) %>
              <%= link_to t("approvals.actions.keep_editing"), queue_path, class: style(:button, tone: :secondary) %>
            </div>
          <% end %>
        <% elsif mode == "defer" %>
          <%= form_with url: decision_path(mode: "defer"), method: :patch, scope: :approval_request, class: "mt-6 space-y-4" do |form| %>
            <%= form.hidden_field :decision, value: "defer" %>
            <%= form.hidden_field :lock_version, value: item.lock_version %>
            <div>
              <%= form.label :deferred_until, t("approvals.defer.label"), class: "block text-sm font-semibold text-ink" %>
              <p class="mt-1 text-sm leading-6 text-quiet-note"><%= t("approvals.defer.hint") %></p>
              <%= form.datetime_local_field :deferred_until, required: true, min: deferral_min, class: "mt-2 min-h-11 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary" %>
            </div>
            <div class="flex flex-wrap gap-2">
              <%= form.submit t("approvals.actions.keep_for_later"), class: style(:button, tone: :primary) %>
              <%= link_to t("approvals.actions.keep_reviewing"), queue_path, class: style(:button, tone: :secondary) %>
            </div>
          <% end %>
        <% else %>
          <p class="mt-6 text-sm leading-6 text-quiet-note"><%= t("approvals.detail.decision_help") %></p>
          <div class="mt-5 flex flex-col gap-2">
            <%= button_to t("approvals.actions.approve"), decision_path, method: :patch, params: decision_params("approve"), class: "w-full #{style(:button, tone: :primary)}" %>
            <% if item.edit_supported? %>
              <%= link_to t("approvals.actions.edit"), queue_path(mode: "edit"), class: "w-full #{style(:button, tone: :secondary)}" %>
            <% end %>
            <%= link_to t("approvals.actions.keep_for_later"), queue_path(mode: "defer"), class: "w-full #{style(:button, tone: :secondary)}" %>
            <%= button_to t("approvals.actions.reject"), decision_path, method: :patch, params: decision_params("reject"), class: "w-full #{style(:button, tone: :danger)}" %>
            <%= button_to t("approvals.actions.dismiss"), decision_path, method: :patch, params: decision_params("dismiss"), class: "w-full #{style(:button, tone: :quiet)}" %>
          </div>
        <% end %>
      <% else %>
        <% if item.status == "deferred" && item.deferred_until.present? %>
          <p class="mt-6 rounded-xl bg-surface px-4 py-4 text-sm leading-6 text-quiet-note"><%= t("approvals.detail.deferred_until", date: l(owner_local_time(item.deferred_until), format: :approval)) %></p>
        <% else %>
          <p class="mt-6 rounded-xl bg-surface px-4 py-4 text-sm leading-6 text-quiet-note"><%= t(item.superseded? ? "approvals.detail.superseded_completed" : "approvals.detail.completed", status: t("approvals.statuses.#{item.status}")) %></p>
        <% end %>
      <% end %>
    </section>
  </div>

  <section class="border-t border-private-line px-5 py-6 sm:px-7" aria-labelledby="approval-history-title">
    <h3 id="approval-history-title" class="text-lg font-semibold text-ink"><%= t("approvals.history.title") %></h3>
    <% if item.approval_decisions.any? %>
      <ol class="mt-4 divide-y divide-private-line">
        <% item.approval_decisions.each do |entry| %>
          <li class="flex flex-col gap-1 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
            <span class="font-semibold text-ink"><%= t("approvals.decisions.#{entry.decision}") %></span>
            <time class="text-quiet-note" datetime="<%= entry.occurred_at.iso8601 %>"><%= l(owner_local_time(entry.occurred_at), format: :approval) %></time>
          </li>
        <% end %>
      </ol>
    <% end %>
    <% if item.superseded? %>
      <p class="mt-3 text-sm leading-6 text-quiet-note"><%= t("approvals.history.superseded") %></p>
    <% elsif item.approval_decisions.empty? %>
      <p class="mt-3 text-sm leading-6 text-quiet-note"><%= t("approvals.history.queued", date: l(owner_local_time(item.created_at), format: :approval)) %></p>
    <% end %>
  </section>
</article>
