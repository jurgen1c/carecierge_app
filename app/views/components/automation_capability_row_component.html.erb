<div class="<%= style %>"
     data-automation-permissions-target="row"
     data-capability-row="<%= capability.key %>"
     data-selected="<%= selected %>">
  <div class="min-w-0">
    <%= link_to edit_automation_permissions_path(capability: capability.key),
      class: "inline-flex min-h-11 max-w-full flex-col justify-center rounded-md text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700",
      aria: { controls: "capability-panel-#{capability.key}", current: selected ? "true" : nil },
      data: {
        action: "automation-permissions#select",
        automation_permissions_capability_param: capability.key
      } do %>
      <span class="text-sm font-semibold text-stone-950"><%= capability_name %></span>
      <span class="mt-1 text-sm leading-5 text-stone-600"><%= capability_description %></span>
    <% end %>
    <% if override_count.positive? %>
      <p class="mt-1 text-xs font-medium text-emerald-900"><%= t("automation_permissions.edit.override_count", count: override_count) %></p>
    <% end %>
  </div>

  <div>
    <span class="lg:hidden text-xs font-semibold text-stone-600"><%= t("automation_permissions.edit.risk") %></span>
    <span class="<%= style(:risk, risk: capability.risk_level.to_sym) %>"><%= t("automation_permissions.risks.#{capability.risk_level}") %></span>
  </div>

  <%= component "automation_permission_mode",
    name: "automation_permissions[modes][#{capability.key}]",
    id_prefix: "automation_permissions_#{capability.key}",
    label: t("automation_permissions.mode_group.account", capability: capability_name),
    selected_mode:,
    allowed_modes: capability.allowed_modes %>
</div>
