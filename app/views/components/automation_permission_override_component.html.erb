<details class="<%= style %>" data-automation-permission-override>
  <summary class="<%= style(:summary) %>">
    <span class="min-w-0">
      <span class="block truncate text-sm font-semibold text-stone-950"><%= relationship_profile.display_name %></span>
      <span class="mt-0.5 block text-xs text-stone-600"><%= relationship_profile.relationship_type_label %></span>
    </span>
    <span class="shrink-0 text-xs font-semibold text-emerald-900"><%= t("automation_permissions.modes.#{permission.mode}") %></span>
  </summary>

  <div class="border-t border-stone-200 px-3 py-3">
    <%= form_with model: permission, url: automation_permission_override_path(permission), method: :patch do %>
      <%= component "automation_permission_mode",
        name: "automation_permission[mode]",
        id_prefix: "automation_permission_#{permission.id}",
        label: t(
          "automation_permissions.mode_group.relationship",
          capability: t("automation_permissions.capabilities.#{capability.key}.name"),
          relationship: relationship_profile.display_name
        ),
        selected_mode: permission.mode,
        allowed_modes: capability.allowed_modes %>
      <%= submit_tag t("automation_permissions.override.save"), class: "mt-3 min-h-11 rounded-lg bg-emerald-800 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <% end %>

    <%= button_to t("automation_permissions.override.remove"),
      automation_permission_override_path(permission),
      method: :delete,
      class: "mt-2 min-h-11 rounded-lg px-3 py-2 text-sm font-semibold text-red-800 hover:bg-red-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
  </div>
</details>
