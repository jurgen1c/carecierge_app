<section id="<%= dom_id %>"<% if show_header %> aria-labelledby="<%= dom_id %>-title"<% end %> class="py-6">
  <% if show_header %>
    <div class="flex flex-col gap-4 border-b border-private-line pb-5 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="<%= dom_id %>-title" class="text-xl font-semibold text-ink"><%= t("bookings.index.title") %></h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("bookings.index.body", plan: event_plan.title) %></p>
      </div>
      <% if editable && visible_bookings.any? %>
        <%= link_to t("bookings.actions.add"), new_event_plan_booking_path(event_plan), class: style(:primary_button) %>
      <% end %>
    </div>
  <% elsif editable && visible_bookings.any? %>
    <div class="flex justify-end border-b border-private-line pb-5">
      <%= link_to t("bookings.actions.add"), new_event_plan_booking_path(event_plan), class: style(:primary_button) %>
    </div>
  <% end %>

  <% if visible_bookings.any? %>
    <ol class="divide-y divide-private-line" data-booking-timeline>
      <% visible_bookings.each do |booking| %>
        <li class="py-5">
          <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-base font-semibold text-ink"><%= booking.title %></h3>
                <span class="<%= style(:status_badge, status: booking.status.to_sym) %>"><%= booking.status_label %></span>
              </div>
              <p class="mt-2 text-sm font-semibold text-ink"><%= booking.booking_kind_label %> · <%= booking.provider_name %></p>
              <p class="mt-1 text-sm text-quiet-note"><%= booking_time(booking) %><% if booking.location.present? %> · <%= booking.location %><% end %></p>
              <% if booking.confirmation_details.present? %>
                <p class="mt-2 text-sm leading-6 text-quiet-note"><span class="font-semibold text-ink"><%= t("bookings.form.confirmation_details") %>:</span> <%= booking.confirmation_details %></p>
              <% end %>
              <% unless compact %>
                <% if booking.cancellation_policy.present? %>
                  <p class="mt-2 text-sm leading-6 text-quiet-note"><span class="font-semibold text-ink"><%= t("bookings.form.cancellation_policy") %>:</span> <%= booking.cancellation_policy %></p>
                <% end %>
                <% if booking.notes.present? %>
                  <p class="mt-2 text-sm leading-6 text-quiet-note"><span class="font-semibold text-ink"><%= t("bookings.form.notes") %>:</span> <%= booking.notes %></p>
                <% end %>
              <% end %>
              <p class="mt-2 text-xs text-quiet-note"><%= t("bookings.index.reminders", count: reminder_count(booking)) %></p>
            </div>
            <div class="flex flex-wrap gap-2 sm:justify-end">
              <% if editable %>
                <%= link_to t("bookings.actions.edit"), edit_booking_path(booking), class: style(:secondary_button) %>
              <% end %>
              <% unless compact %>
                <%= button_to t("bookings.actions.delete"), booking_path(booking), method: :delete, class: style(:danger_button), form: { class: "inline-flex", data: { turbo_confirm: t("bookings.actions.delete_confirm", title: booking.title) } } %>
              <% end %>
            </div>
          </div>

          <% if editable && !compact && available_reminder_milestones(booking).any? %>
            <details class="mt-3">
              <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-semibold text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"><%= t("bookings.reminders.action") %></summary>
              <div class="flex flex-wrap gap-2 pb-2">
                <% available_reminder_milestones(booking).each do |milestone| %>
                  <%= link_to t("bookings.reminders.actions.#{milestone}"), reminder_path(booking, milestone), class: style(:secondary_button) %>
                <% end %>
              </div>
            </details>
          <% end %>
        </li>
      <% end %>
    </ol>
    <% if compact %>
      <%= link_to t("bookings.actions.manage"), event_plan_bookings_path(event_plan), class: "mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4" %>
    <% end %>
  <% else %>
    <div class="py-7">
      <h3 class="text-base font-semibold text-ink"><%= t("bookings.index.empty_title") %></h3>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("bookings.index.empty_body") %></p>
      <% if editable %><%= link_to t("bookings.actions.add"), new_event_plan_booking_path(event_plan), class: "mt-4 #{style(:primary_button)}" %><% end %>
    </div>
  <% end %>

  <p class="border-t border-private-line pt-4 text-sm leading-6 text-quiet-note"><%= t("bookings.review_only") %></p>
</section>
