<header class="border-b border-private-line pb-6">
  <h1 class="text-3xl font-semibold text-ink"><%= t("contacts.heading") %></h1>
  <p class="mt-2 max-w-3xl text-base leading-6 text-quiet-note"><%= t("contacts.body") %></p>
</header>
<section aria-labelledby="contacts-provider" class="flex flex-col gap-4 py-7 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h2 id="contacts-provider" class="text-xl font-semibold text-ink"><%= t("contacts.provider") %></h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t(connection ? "contacts.statuses.#{connection.status}" : (provider_available ? "contacts.available" : "contacts.unavailable")) %></p>
    <% if connection&.last_refreshed_at %><p class="mt-1 text-sm text-quiet-note"><%= t("contacts.refreshed_at", at: l(connection.last_refreshed_at, format: :long)) %></p><% end %>
    <%= link_to t("contacts.permissions"), edit_automation_permissions_path(capability: "access_contacts"), class: "mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" %>
  </div>
  <% if ready? %>
    <%= button_to t("contacts.refresh"), refresh_contacts_connection_path, class: style(:button) %>
  <% elsif !connection && provider_available %>
    <%= link_to t("contacts.connect"), new_contacts_connection_path, data: {turbo: false}, class: style(:button, kind: :primary) %>
  <% end %>
</section>
<% if connection %>
  <% if contacts.empty? %>
    <p role="status" class="border-y border-private-line py-8 text-quiet-note"><%= t("contacts.empty") %></p>
  <% end %>
  <div class="divide-y divide-private-line border-y border-private-line">
    <% contacts.each do |contact| %>
      <% candidates = ready? ? matches(contact) : [] %>
      <article class="py-6" aria-labelledby="contact-<%= contact.id %>">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <div class="min-w-0 lg:w-1/2">
            <h3 id="contact-<%= contact.id %>" class="break-words text-lg font-semibold text-ink"><%= contact.display_name.presence || t("contacts.unnamed") %></h3>
            <% %w[email phone birthday].each do |field| %>
              <p class="mt-1 break-words text-sm text-quiet-note"><%= t("contacts.fields.#{field}") %>: <%= contact.data[field].presence || t("contacts.not_provided") %></p>
            <% end %>
            <p class="mt-2 text-sm text-quiet-note"><%= t("contacts.source") %> · <%= t("contacts.decisions.#{contact.decision}") %></p>
            <% if contact.relationship_profile %>
              <%= link_to contact.relationship_profile.display_name, relationship_profile_path(contact.relationship_profile), class: "mt-2 inline-flex min-h-11 items-center break-words text-sm font-semibold text-primary underline" %>
            <% elsif candidates.any? %>
              <p class="mt-2 text-sm font-semibold text-ink"><%= t("contacts.matches", names: candidates.map(&:display_name).join(", ")) %></p>
            <% end %>
          </div>
          <%= form_with url: decide_contacts_connection_path(contact_id: contact.id), class: "space-y-3 lg:w-1/2" do |form| %>
            <%= form.hidden_field :lock_version, value: contact.lock_version %>
            <%= form.label :choice, t("contacts.choose"), for: "choice-#{contact.id}", class: "block text-sm font-semibold text-ink" %>
            <%= form.select :choice, choice_options(contact, candidates:), {}, id: "choice-#{contact.id}", class: style(:input) %>
            <% if !contact.relationship_profile_id && candidates.any? %>
              <%= form.label :profile_id, t("contacts.match_label"), for: "profile-#{contact.id}", class: "block text-sm font-semibold text-ink" %>
              <%= form.select :profile_id, candidates.reject(&:discarded?).map { |profile| [profile.display_name, profile.id] }, {include_blank: t("contacts.select_match")}, id: "profile-#{contact.id}", class: style(:input) %>
              <% if candidates.any? %>
                <label class="flex min-h-11 items-center gap-3 text-sm text-quiet-note"><%= form.check_box :allow_duplicate, class: "size-5 accent-primary" %><%= t("contacts.duplicate_override") %></label>
              <% end %>
            <% end %>
            <p class="text-sm leading-5 text-quiet-note"><%= t(ready? ? (contact.relationship_profile_id ? "contacts.update_help" : "contacts.link_help") : "contacts.cleanup_help") %></p>
            <%= form.submit t("contacts.save"), class: style(:button, kind: :primary) %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
  <nav aria-label="<%= t("contacts.pagination") %>" class="flex flex-wrap gap-3 py-5">
    <% if page > 1 %><%= link_to t("contacts.previous"), contacts_connection_path(page: page - 1), class: style(:button) %><% end %>
    <% if more %><%= link_to t("contacts.next"), contacts_connection_path(page: page + 1), class: style(:button) %><% end %>
    <% if ready? && connection.next_page_token.present? %><%= button_to t("contacts.load_more"), refresh_contacts_connection_path(more: "1"), class: style(:button) %><% end %>
  </nav>
<% end %>
<section aria-labelledby="contacts-privacy" class="border-t border-private-line py-7">
  <h2 id="contacts-privacy" class="text-xl font-semibold text-ink"><%= t("contacts.privacy_heading") %></h2>
  <p class="mt-2 max-w-3xl text-sm leading-6 text-quiet-note"><%= t("contacts.privacy_body") %></p>
  <% if connection %>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-quiet-note"><%= t("contacts.disconnect_help") %></p>
    <%= button_to t("contacts.disconnect"), contacts_connection_path, method: :delete, class: style(:button, kind: :danger), form: {class: "mt-4"} %>
  <% end %>
</section>
