<article data-feed-item data-feed-item-key="<%= item.key %>" class="<%= style(featured:, compact:) %>">
  <div class="flex gap-3 sm:gap-4">
    <div class="flex size-10 shrink-0 items-center justify-center rounded-full border border-private-line bg-surface text-sm font-semibold text-primary" aria-hidden="true">
      <%= initials %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <h3 class="break-words text-base font-semibold text-ink"><%= item.title %></h3>
            <% if item.section == "needs_attention" %>
              <span class="<%= style(:urgency) %>"><%= t("daily_feed.urgency.needs_attention") %></span>
            <% end %>
          </div>
          <p class="mt-1 break-words text-sm leading-6 text-quiet-note"><%= item.detail %></p>
          <p class="mt-2 break-words text-xs font-medium text-quiet-note">
            <span><%= relationship_name %></span>
            <span aria-hidden="true"> · </span>
            <span><%= item.source_label %></span>
          </p>
        </div>

        <% unless compact %>
          <div class="flex shrink-0 flex-wrap gap-2 sm:justify-end">
            <% if source_action %>
              <% if source_action[:method] %>
                <%= button_to source_action[:label], source_action[:path], method: source_action[:method], form: { data: { turbo: false } }, class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-canvas transition hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
              <% else %>
                <%= link_to source_action[:label], source_action[:path], class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-canvas transition hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
              <% end %>
            <% end %>
            <%= button_to t("daily_feed.actions.snooze"), snooze_feed_item_path(item.key), method: :patch, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-private-line bg-canvas px-4 py-2 text-sm font-semibold text-ink transition hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
            <%= button_to t("daily_feed.actions.dismiss"), dismiss_feed_item_path(item.key), method: :patch, class: "inline-flex min-h-11 items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold text-quiet-note transition hover:bg-surface hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
          </div>
        <% end %>
      </div>

      <details class="mt-3 rounded-lg bg-surface px-4 py-3" <%= "open" if featured %>>
        <summary class="cursor-pointer text-sm font-semibold text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          <%= t("daily_feed.source_context.summary") %>
        </summary>
        <% if item.source_certainty.present? %>
          <span class="mt-2 <%= style(:certainty, certainty: item.source_certainty.to_sym) %>"><%= t("daily_feed.certainty.#{item.source_certainty}") %></span>
        <% end %>
        <p class="mt-2 max-w-2xl break-words text-sm leading-6 text-quiet-note"><%= item.source_context %></p>
        <% if item.relationship_profile %>
          <%= link_to t("daily_feed.source_context.open_profile", name: relationship_name), relationship_profile_path(item.relationship_profile), class: "mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:text-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
        <% end %>
      </details>

      <% if compact %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% if source_action %>
            <% if source_action[:method] %>
              <%= button_to source_action[:label], source_action[:path], method: source_action[:method], form: { data: { turbo: false } }, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-primary bg-canvas px-3 py-2 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
            <% else %>
              <%= link_to source_action[:label], source_action[:path], class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-primary bg-canvas px-3 py-2 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
            <% end %>
          <% end %>
          <%= button_to t("daily_feed.actions.snooze"), snooze_feed_item_path(item.key), method: :patch, class: "inline-flex min-h-11 items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold text-quiet-note hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
          <%= button_to t("daily_feed.actions.dismiss"), dismiss_feed_item_path(item.key), method: :patch, class: "inline-flex min-h-11 items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold text-quiet-note hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</article>
