<article data-feed-item data-feed-item-key="<%= item.key %>" class="<%= style(featured:, compact:) %>">
  <div class="feed-person-row">
    <% if item.relationship_profile %>
      <%= link_to relationship_profile_path(item.relationship_profile), class: 'feed-person-link' do %><%= component 'person_identity', name: relationship_name, subtitle: item.source_label %><% end %>
    <% else %>
      <%= component 'person_identity', name: relationship_name, subtitle: item.source_label %>
    <% end %>
    <% if scheduled_at %><time class="feed-date" datetime="<%= scheduled_at.iso8601 %>"><%= scheduled_label %></time><% end %>
  </div>
  <h3 class="feed-title"><%= item.title %></h3>
  <% if item.section == 'needs_attention' %><span class="<%= style(:urgency) %>"><%= t('daily_feed.urgency.needs_attention') %></span><% end %>
  <% if item.detail.present? && item.detail != relationship_name && item.detail != item.title %><p class="feed-detail"><%= item.detail %></p><% end %>
  <div class="feed-actions">
    <% if source_action %>
      <% if source_action[:method] %>
        <%= button_to source_action[:label], source_action[:path], method: source_action[:method], form: { data: { turbo: false } }, class: style(:primary_action) %>
      <% else %>
        <%= link_to source_action[:label], source_action[:path], class: style(:primary_action) %>
      <% end %>
    <% end %>
    <%= button_to t('daily_feed.actions.snooze'), snooze_feed_item_path(item.key), method: :patch, class: 'workspace-action workspace-action-quiet' %>
    <%= button_to t('daily_feed.actions.dismiss'), dismiss_feed_item_path(item.key), method: :patch, class: 'workspace-action workspace-action-quiet' %>
  </div>
  <details class="feed-source" <%= 'open' if featured %>>
    <summary><%= t('daily_feed.source_context.summary') %></summary>
    <% if item.source_certainty.present? %><span class="<%= style(:certainty, certainty: item.source_certainty.to_sym) %>"><%= t("daily_feed.certainty.#{item.source_certainty}") %></span><% end %>
    <p><%= item.source_context %></p>
    <% if item.relationship_profile %><%= link_to t('daily_feed.source_context.open_profile', name: relationship_name), relationship_profile_path(item.relationship_profile), class: 'workspace-action workspace-action-quiet' %><% end %>
  </details>
</article>
