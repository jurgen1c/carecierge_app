<article aria-labelledby="<%= dom_id(extracted_memory, :review_title) %>" class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm shadow-stone-200/40">
  <div class="flex flex-wrap items-center gap-2">
    <span class="<%= style(:badge, tone: :category) %>"><%= extracted_memory.category_label %></span>
    <span class="<%= style(:badge, tone: confidence_tone) %>"><%= t("extracted_memories.review.confidence", confidence: extracted_memory.confidence_label) %></span>
  </div>

  <h3 id="<%= dom_id(extracted_memory, :review_title) %>" class="mt-4 text-xl font-semibold text-stone-950"><%= extracted_memory.title %></h3>
  <p class="mt-2 text-sm leading-6 text-stone-700"><%= extracted_memory.body %></p>

  <section class="mt-5 rounded-lg border border-stone-200 bg-stone-50 p-4" aria-labelledby="<%= dom_id(extracted_memory, :source_title) %>">
    <h4 id="<%= dom_id(extracted_memory, :source_title) %>" class="text-sm font-semibold text-stone-950"><%= t("extracted_memories.review.source_title") %></h4>
    <p class="mt-1 text-xs font-medium text-stone-600"><%= extracted_memory.conversation_recap.title %> · <%= l(extracted_memory.conversation_recap.occurred_at.to_date, format: :long) %></p>
    <blockquote class="mt-3 border-l-2 border-emerald-700 pl-3 text-sm leading-6 text-stone-700"><%= extracted_memory.source_excerpt %></blockquote>
  </section>

  <section class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4">
    <h4 class="text-sm font-semibold text-amber-950"><%= t("extracted_memories.review.uncertainty_title") %></h4>
    <p class="mt-1 text-sm leading-6 text-amber-900"><%= t("extracted_memories.review.uncertainty.#{extracted_memory.confidence}") %></p>
  </section>

  <div class="mt-5 flex flex-wrap gap-3">
    <%= button_to t("extracted_memories.review.approve"), review_path,
      method: :patch,
      params: { extracted_memory: { decision: "approve" } },
      class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <%= button_to t("extracted_memories.review.reject"), review_path,
      method: :patch,
      params: { extracted_memory: { decision: "reject" } },
      class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-900 transition hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-700" %>
  </div>

  <details class="mt-5 rounded-lg border border-stone-200 bg-white p-4">
    <summary class="min-h-11 cursor-pointer text-sm font-semibold text-stone-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"><%= t("extracted_memories.review.correct") %></summary>
    <%= form_with url: review_path, method: :patch, scope: :extracted_memory, class: "mt-4 grid gap-4" do |form| %>
      <%= form.hidden_field :decision, value: "correct" %>
      <div>
        <%= form.label :corrected_title, t("extracted_memories.review.corrected_title"), class: "block text-sm font-medium text-stone-800" %>
        <%= form.text_field :corrected_title, value: extracted_memory.title, required: true, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
      </div>
      <div>
        <%= form.label :corrected_body, t("extracted_memories.review.corrected_body"), class: "block text-sm font-medium text-stone-800" %>
        <%= form.text_area :corrected_body, value: extracted_memory.body, rows: 4, required: true, class: "mt-2 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
      </div>
      <p class="text-xs leading-5 text-stone-600"><%= t("extracted_memories.review.correction_note") %></p>
      <%= form.submit t("extracted_memories.review.save_correction"), class: "inline-flex min-h-11 w-fit items-center justify-center rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <% end %>
  </details>
</article>
