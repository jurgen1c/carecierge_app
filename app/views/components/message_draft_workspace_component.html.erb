<section id="message-drafting" aria-labelledby="message-drafting-title" class="overflow-hidden rounded-2xl border border-private-line bg-canvas shadow-sm shadow-stone-200/40">
  <header class="border-b border-private-line bg-surface px-5 py-5 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 id="message-drafting-title" class="text-xl font-semibold text-ink"><%= t("message_drafts.workspace.title") %></h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-quiet-note"><%= t("message_drafts.workspace.body") %></p>
      </div>
      <p class="inline-flex min-h-11 items-center rounded-lg border border-primary/30 bg-surface px-4 py-2 text-sm font-semibold text-primary">
        <%= t("message_drafts.workspace.draft_only") %>
      </p>
    </div>
  </header>

  <div class="<%= style(:layout) %>">
    <aside class="border-b border-private-line bg-surface p-5 lg:border-b-0 lg:border-r sm:p-6">
      <%= form_with scope: :message_draft,
        url: generate_relationship_profile_message_draft_path(relationship_profile),
        method: :post,
        html: { id: "message-draft-generation-form" },
        class: "space-y-6" do |form| %>
        <fieldset class="space-y-4">
          <legend class="text-base font-semibold text-ink"><%= t("message_drafts.workspace.setup") %></legend>

          <div>
            <%= form.label :draft_type, t("message_drafts.fields.draft_type"), class: "block text-sm font-semibold text-ink" %>
            <%= form.select :draft_type,
              MessageDraft::DRAFT_TYPES.map { |value| [ t("message_drafts.types.#{value}"), value ] },
              { selected: draft_type },
              class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
          </div>

          <div>
            <%= form.label :tone, t("message_drafts.fields.tone"), class: "block text-sm font-semibold text-ink" %>
            <%= form.select :tone,
              MessageDraft::TONES.map { |value| [ t("message_drafts.tones.#{value}"), value ] },
              { selected: tone },
              class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
          </div>
        </fieldset>

        <fieldset class="border-t border-private-line pt-5">
          <legend class="text-base font-semibold text-ink"><%= t("message_drafts.context.title") %></legend>
          <p class="mt-2 text-sm leading-6 text-quiet-note"><%= t("message_drafts.context.body") %></p>
          <ul class="mt-4 space-y-3">
            <% context_categories.each do |category| %>
              <li class="flex items-center gap-3 text-sm text-ink">
                <span aria-hidden="true" class="size-2 rounded-full bg-primary"></span>
                <%= context_label(category) %>
              </li>
            <% end %>
          </ul>
        </fieldset>

        <fieldset class="border-t border-private-line pt-5">
          <legend class="text-base font-semibold text-ink"><%= t("message_drafts.private_context.title") %></legend>
          <p class="mt-2 text-sm leading-6 text-quiet-note"><%= t("message_drafts.private_context.body") %></p>

          <label class="mt-4 flex min-h-11 items-start gap-3 text-sm text-ink">
            <%= form.check_box :use_private_notes,
              { disabled: !private_notes_available, class: "mt-1 size-5 rounded border-stone-300 text-primary focus:ring-primary" },
              "1",
              "0" %>
            <span>
              <span class="font-semibold"><%= t("message_drafts.private_context.private_notes") %></span>
              <span class="mt-1 block leading-5 text-quiet-note"><%= t("message_drafts.private_context.private_notes_hint") %></span>
            </span>
          </label>

          <label class="mt-3 flex min-h-11 items-start gap-3 text-sm text-ink">
            <%= form.check_box :use_vault_context,
              { disabled: !vault_items_available || !vault_unlocked, class: "mt-1 size-5 rounded border-stone-300 text-primary focus:ring-primary" },
              "1",
              "0" %>
            <span>
              <span class="font-semibold"><%= t("message_drafts.private_context.vault_items") %></span>
              <span class="mt-1 block leading-5 text-quiet-note"><%= t("message_drafts.private_context.vault_items_hint") %></span>
            </span>
          </label>

          <% if vault_items_available && !vault_unlocked %>
            <%= link_to t("message_drafts.private_context.unlock_vault"),
              relationship_profile_privacy_vault_path(relationship_profile),
              class: "mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline decoration-primary underline-offset-4 hover:text-primary-hover" %>
          <% end %>
        </fieldset>
      <% end %>
    </aside>

    <div class="min-w-0 p-5 sm:p-6">
      <div class="space-y-4">
        <div>
          <%= label_tag "message_draft_content", t("message_drafts.fields.content"), class: "block text-sm font-semibold text-ink" %>
          <%= text_area_tag "message_draft[content]",
            content,
            rows: 12,
            maxlength: DraftRevision::MAX_CONTENT_LENGTH,
            placeholder: t("message_drafts.workspace.placeholder"),
            form: "message-draft-generation-form",
            class: "mt-2 w-full rounded-lg border border-stone-300 bg-canvas px-4 py-3 text-base leading-7 text-ink placeholder:text-stone-600 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <%= button_tag message_draft ? t("message_drafts.actions.generate_revision") : t("message_drafts.actions.generate"),
            type: "submit",
            form: "message-draft-generation-form",
            class: style(:primary_button),
            data: { turbo_submits_with: t("message_drafts.actions.generating") } %>
          <%= button_tag t("message_drafts.actions.save"),
            type: "submit",
            form: "message-draft-generation-form",
            formaction: relationship_profile_message_draft_path(relationship_profile),
            name: "_method",
            value: "patch",
            class: style(:secondary_button),
            disabled: message_draft.blank?,
            data: { turbo_submits_with: t("message_drafts.actions.saving") } %>
          <% if message_draft&.current_revision %>
            <span class="ml-auto text-xs text-quiet-note"><%= t("message_drafts.workspace.word_count", count: content.split.size) %></span>
          <% end %>
        </div>
      </div>

      <section class="mt-8 border-t border-private-line pt-6" aria-labelledby="message-draft-history-title">
        <h3 id="message-draft-history-title" class="text-base font-semibold text-ink"><%= t("message_drafts.history.title") %></h3>

        <% if revisions.any? %>
          <ol class="mt-4 divide-y divide-private-line border-y border-private-line">
            <% revisions.each do |revision| %>
              <li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <% if current_revision?(revision) %>
                      <span class="rounded-full border border-primary/30 bg-surface px-3 py-1 text-xs font-semibold text-primary"><%= t("message_drafts.history.current") %></span>
                    <% end %>
                    <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-700"><%= t("message_drafts.origins.#{revision.origin}") %></span>
                    <time class="text-xs text-quiet-note" datetime="<%= revision.created_at.iso8601 %>"><%= l(revision.created_at, format: :short) %></time>
                  </div>
                  <p class="mt-2 line-clamp-2 text-sm leading-6 text-quiet-note"><%= revision.content %></p>
                </div>
                <%= button_to t("message_drafts.actions.restore"),
                  restore_revision_relationship_profile_message_draft_path(relationship_profile, revision_id: revision.id),
                  method: :post,
                  class: style(:secondary_button) %>
              </li>
            <% end %>
          </ol>
          <% if revisions_pagy && revisions_pagy.last > 1 %>
            <nav aria-label="<%= t('message_drafts.history.pagination.aria_label') %>" class="flex flex-col gap-3 border-b border-private-line py-4 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-quiet-note"><%= t("message_drafts.history.pagination.info", from: revisions_pagy.from, to: revisions_pagy.to, count: revisions_pagy.count) %></p>
              <div class="flex items-center gap-2">
                <% if revisions_pagy.previous %>
                  <%= link_to t("message_drafts.history.pagination.previous"), revision_page_path(revisions_pagy.previous), class: style(:secondary_button) %>
                <% end %>
                <span class="px-2 text-sm font-medium text-quiet-note"><%= t("message_drafts.history.pagination.page", page: revisions_pagy.page, pages: revisions_pagy.last) %></span>
                <% if revisions_pagy.next %>
                  <%= link_to t("message_drafts.history.pagination.next"), revision_page_path(revisions_pagy.next), class: style(:secondary_button) %>
                <% end %>
              </div>
            </nav>
          <% end %>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-quiet-note"><%= t("message_drafts.history.empty") %></p>
        <% end %>
      </section>

      <% if message_draft %>
        <div class="mt-6 flex justify-end">
          <%= button_to t("message_drafts.actions.delete"),
            relationship_profile_message_draft_path(relationship_profile),
            method: :delete,
            form: { data: { turbo_confirm: t("message_drafts.actions.delete_confirm") } },
            class: style(:danger_button) %>
        </div>
      <% end %>
    </div>
  </div>
</section>
