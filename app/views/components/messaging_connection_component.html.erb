<section aria-labelledby="messaging-title" class="space-y-6">
  <header class="max-w-3xl">
    <h1 id="messaging-title" class="text-3xl font-semibold text-ink"><%= t('messaging.heading') %></h1>
    <p class="mt-3 text-base leading-6 text-quiet-note"><%= t('messaging.body') %></p>
    <%= link_to t('messaging.permissions'), automation_permissions_path, class: style(:button), data: { turbo: false } %>
  </header>
  <% if connection %>
    <p class="rounded-xl border border-private-line bg-surface p-4 text-ink"><%= t("messaging.statuses.#{connection.status}") %></p>
  <% elsif provider_available %>
    <%= form_with url: connect_messaging_connection_path, data: { turbo: false }, class: "space-y-3 max-w-3xl" do |form| %>
      <label class="flex min-h-11 items-start gap-3 text-sm leading-6 text-ink"><%= form.check_box :approved, { required: true, class: "mt-1 size-5 accent-primary" }, '1', '0' %><span><%= t('messaging.connect_consent') %></span></label>
      <%= form.submit t('messaging.connect'), class: style(:button, kind: :primary) %>
    <% end %>
  <% else %>
    <p class="text-quiet-note"><%= t('messaging.unavailable') %></p>
  <% end %>
  <% if ready? %>
    <%= form_with url: search_messaging_connection_path, class: "max-w-3xl space-y-3" do |form| %>
      <%= form.label :messaging_query, t('messaging.search_label'), class: 'block font-semibold text-ink' %>
      <%= form.text_field :messaging_query, required: true, maxlength: 300, class: style(:input), aria: { describedby: 'messaging-search-help' } %>
      <p id="messaging-search-help" class="text-sm leading-6 text-quiet-note"><%= t('messaging.search_help') %></p>
      <%= form.submit t('messaging.search'), class: style(:button, kind: :primary), data: { turbo_submits_with: t('messaging.searching') } %>
    <% end %>
  <% end %>
  <% if results %>
    <section aria-labelledby="messaging-results-title" class="space-y-4">
      <h2 id="messaging-results-title" class="text-xl font-semibold text-ink"><%= t('messaging.results') %></h2>
      <% if results.empty? %><p class="text-quiet-note"><%= t('messaging.no_results') %></p><% end %>
      <ul class="divide-y divide-private-line">
        <% results.each do |result| %>
          <li class="space-y-3 py-5">
            <h3 class="break-words font-semibold text-ink"><%= result[:subject].presence || t('messaging.no_subject') %></h3>
            <p class="max-w-3xl break-words text-base leading-6 text-quiet-note"><%= result[:snippet] %></p>
            <%= button_to t('messaging.import'), import_messaging_connection_path, params: { external_id: result[:external_id], approved: '1' }, class: style(:button) %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <section aria-labelledby="messaging-saved-title" class="space-y-4">
    <h2 id="messaging-saved-title" class="text-xl font-semibold text-ink"><%= t('messaging.saved') %></h2>
    <p class="max-w-3xl text-sm leading-6 text-quiet-note"><%= t('messaging.excluded') %> <%= t('messaging.draft_help') %></p>
    <% if contexts.empty? %><p class="text-quiet-note"><%= t('messaging.empty') %></p><% end %>
    <ul class="divide-y divide-private-line">
      <% contexts.each do |context| %>
        <li class="space-y-4 py-6" id="<%= dom_id(context) %>">
          <h3 class="break-words text-lg font-semibold text-ink"><%= context.subject.presence || t('messaging.no_subject') %></h3>
          <p class="max-w-3xl break-words text-base leading-6 text-quiet-note"><%= context.snippet %></p>
          <%= link_to t('messaging.source'), context.source_url, target: '_blank', rel: 'noopener noreferrer', referrerpolicy: 'no-referrer', class: style(:button) %>
          <%= form_with url: draft_messaging_connection_path, class: 'max-w-3xl space-y-3' do |form| %>
            <%= form.hidden_field :context_id, value: context.id %>
            <%= form.hidden_field :lock_version, value: context.lock_version %>
            <label class="flex min-h-11 items-start gap-3 text-sm leading-6 text-ink"><%= form.check_box :approved, { id: "draft-consent-#{context.id}", required: true, class: 'mt-1 size-5 accent-primary' }, '1', '0' %><span><%= t('messaging.draft_consent') %></span></label>
            <%= form.submit t('messaging.draft'), class: style(:button), data: { turbo_submits_with: t('messaging.drafting') } %>
          <% end %>
          <%= form_with url: edit_draft_messaging_connection_path, method: :patch, class: 'max-w-3xl space-y-3' do |form| %>
            <%= form.hidden_field :context_id, value: context.id %>
            <%= form.hidden_field :lock_version, value: context.lock_version %>
            <%= form.label :reply_draft, t('messaging.reply'), for: "reply-#{context.id}", class: 'block font-semibold text-ink' %>
            <%= form.text_area :reply_draft, id: "reply-#{context.id}", value: context.reply_draft, rows: 5, maxlength: DraftRevision::MAX_CONTENT_LENGTH, class: style(:input) %>
            <%= form.submit t('messaging.save'), class: style(:button) %>
          <% end %>
          <%= button_to t('messaging.delete'), delete_context_messaging_connection_path, method: :delete, params: { context_id: context.id }, class: style(:button, kind: :danger) %>
        </li>
      <% end %>
    </ul>
    <nav aria-label="<%= t('messaging.pages') %>" class="flex flex-wrap gap-3">
      <% if page > 1 %><%= link_to t('messaging.previous'), messaging_connection_path(page: page - 1), class: style(:button) %><% end %>
      <% if more %><%= link_to t('messaging.next'), messaging_connection_path(page: page + 1), class: style(:button) %><% end %>
    </nav>
  </section>
  <% if connection %>
    <section class="border-t border-private-line pt-6 space-y-3" aria-labelledby="messaging-disconnect-title">
      <h2 id="messaging-disconnect-title" class="text-xl font-semibold text-ink"><%= t('messaging.disconnect') %></h2>
      <p class="max-w-3xl text-sm leading-6 text-quiet-note"><%= t('messaging.disconnect_help') %></p>
      <%= button_to t('messaging.disconnect'), messaging_connection_path, method: :delete, class: style(:button, kind: :danger) %>
    </section>
  <% end %>
</section>
