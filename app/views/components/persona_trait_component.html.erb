<article class="grid gap-3 border-b border-stone-200 py-4 last:border-b-0 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
  <div class="min-w-0">
    <span class="<%= style(:badge, tone: badge_tone) %>"><%= t("relationship_personas.trait.#{trait.certainty}") %></span>
    <h3 class="mt-3 text-base font-semibold text-stone-950"><%= trait.statement %></h3>
    <% if trait.detail != trait.evidence %>
      <p class="mt-2 text-sm leading-6 text-stone-700"><%= trait.detail %></p>
    <% end %>
    <p class="mt-2 text-sm leading-6 text-stone-700">
      <span class="font-semibold text-stone-800"><%= t("relationship_personas.trait.why") %></span>
      <%= trait.evidence %>
    </p>
  </div>

  <div class="flex flex-wrap gap-2 md:justify-end">
    <%= link_to t("relationship_personas.trait.review_evidence"), evidence_path, data: { turbo_frame: "_top" }, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 transition hover:bg-stone-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <%= link_to t("relationship_personas.trait.correct"), correction_path, data: { turbo_frame: correction_turbo_frame }, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-emerald-700 bg-white px-4 py-2 text-sm font-semibold text-emerald-900 transition hover:bg-emerald-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
  </div>
</article>
