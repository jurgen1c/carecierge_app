<section id="social-context" aria-labelledby="social-context-title" class="<%= style(:ledger) %>">
  <header class="border-b border-private-line bg-surface px-5 py-5 sm:px-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-sm font-semibold text-primary"><%= t("social_context_notes.section.eyebrow") %></p>
        <h2 id="social-context-title" class="mt-2 text-xl font-semibold text-ink"><%= t("social_context_notes.section.title") %></h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-quiet-note"><%= t("social_context_notes.section.body") %></p>
      </div>
      <p class="rounded-lg border border-private-line bg-canvas px-4 py-2 text-sm font-semibold text-ink">
        <%= t("social_context_notes.section.provenance") %>
      </p>
    </div>
    <p class="mt-4 rounded-lg border border-private-line bg-canvas px-4 py-3 text-sm leading-6 text-quiet-note">
      <%= t("social_context_notes.section.trust") %>
    </p>
  </header>

  <div class="divide-y divide-private-line">
    <% notes.each do |note| %>
      <details id="<%= dom_id(note, :row) %>" <%= "open" if note.interpretation_status == "draft" || note.errors.any? %> class="group px-5 py-4 sm:px-6">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          <span class="min-w-0">
            <span class="block truncate text-sm font-semibold text-ink"><%= note.display_title %></span>
            <span class="mt-1 flex flex-wrap items-center gap-2 text-xs text-quiet-note">
              <span><%= t("social_context_notes.section.added_by_you") %></span>
              <span aria-hidden="true">·</span>
              <time datetime="<%= note.created_at.iso8601 %>"><%= l(note.created_at, format: :social_context_note) %></time>
              <span class="rounded-full border border-private-line bg-surface px-2 py-0.5 font-semibold text-primary"><%= status_label(note) %></span>
            </span>
          </span>
          <span aria-hidden="true" class="text-lg text-primary transition group-open:rotate-45">+</span>
        </summary>

        <div class="mt-4 border-t border-private-line pt-4">
          <%= form_with model: note, scope: :social_context_note, url: note_form_path(note), id: update_form_id(note), class: "space-y-5" do |form| %>
            <%= form.hidden_field :lock_version %>
            <% if note.errors.any? %>
              <div id="<%= error_summary_id(note) %>" role="alert" class="rounded-lg border border-danger-border bg-danger-surface px-4 py-3 text-sm text-danger-ink">
                <p class="font-semibold"><%= t("social_context_notes.errors.title") %></p>
                <ul class="mt-2 list-disc space-y-1 pl-5">
                  <% note.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            <div>
              <%= form.label :body, t("social_context_notes.fields.body"), for: social_context_field_id(note, :body), class: "block text-sm font-semibold text-ink" %>
              <p class="mt-1 text-sm leading-5 text-quiet-note"><%= t("social_context_notes.fields.body_hint") %></p>
              <%= form.rich_text_area :body,
                id: social_context_field_id(note, :body),
                aria: ({ describedby: error_summary_id(note) } if note.errors.any?),
                class: "lexxy-content mt-2 min-h-32 w-full rounded-lg border border-stone-300 bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20",
                disabled: !editable %>
            </div>

            <% if note.interpretation.present? %>
              <div class="rounded-lg border border-private-line bg-surface p-4">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="text-sm font-semibold text-ink"><%= t("social_context_notes.interpretation.title") %></h3>
                  <span class="text-xs font-semibold text-primary"><%= status_label(note) %></span>
                </div>
                <p class="mt-2 text-sm leading-5 text-quiet-note"><%= t("social_context_notes.interpretation.body") %></p>
                <%= form.label :interpretation, t("social_context_notes.fields.interpretation"), for: social_context_field_id(note, :interpretation), class: "mt-4 block text-sm font-semibold text-ink" %>
                <%= form.text_area :interpretation, rows: 4, maxlength: SocialContextNote::MAX_INTERPRETATION_CHARACTERS,
                  id: social_context_field_id(note, :interpretation),
                  class: "mt-2 w-full rounded-lg border border-stone-300 bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20",
                  disabled: !editable %>
                <fieldset class="mt-4">
                  <legend class="text-sm font-semibold text-ink"><%= t("social_context_notes.suggested_uses.legend") %></legend>
                  <p class="mt-1 text-xs leading-5 text-quiet-note"><%= t("social_context_notes.suggested_uses.hint") %></p>
                  <%= hidden_field_tag "social_context_note[suggested_uses][]", "" %>
                  <div class="mt-3 grid gap-2 sm:grid-cols-2">
                    <% SocialContextNote::SUGGESTED_USES.each do |use| %>
                      <label for="<%= suggested_use_field_id(note, use) %>" class="flex min-h-11 items-center gap-3 rounded-lg border border-private-line bg-canvas px-3 py-2 text-sm text-ink">
                        <%= check_box_tag "social_context_note[suggested_uses][]", use, note.suggested_uses.include?(use),
                          id: suggested_use_field_id(note, use),
                          class: "size-5 rounded border-stone-300 text-primary focus:ring-primary",
                          disabled: !editable %>
                        <span><%= t("social_context_notes.suggested_uses.options.#{use}") %></span>
                      </label>
                    <% end %>
                  </div>
                </fieldset>
                <% if note.interpretation_status == "draft" %>
                  <%= form.hidden_field :approve_interpretation, value: "1" %>
                  <p class="mt-2 text-xs leading-5 text-quiet-note"><%= t("social_context_notes.interpretation.approval_hint") %></p>
                <% end %>
              </div>
            <% end %>

            <label class="flex min-h-11 items-start gap-3 text-sm text-ink">
              <%= form.check_box :allow_suggestions,
                { id: social_context_field_id(note, :allow_suggestions), class: "mt-1 size-5 rounded border-stone-300 text-primary focus:ring-primary", disabled: !editable },
                "1", "0" %>
              <span>
                <span class="font-semibold"><%= t("social_context_notes.fields.allow_suggestions") %></span>
                <span class="mt-1 block leading-5 text-quiet-note"><%= t("social_context_notes.fields.allow_suggestions_hint") %></span>
              </span>
            </label>

            <% if editable %>
              <div class="flex flex-wrap items-center gap-3 border-t border-private-line pt-4">
                <%= form.submit t("social_context_notes.actions.save"), class: style(:secondary_button), data: { turbo_submits_with: t("social_context_notes.actions.saving") } %>
                <p class="w-full text-xs leading-5 text-quiet-note"><%= t("social_context_notes.analyze.disclosure") %></p>
                <% if permission_enabled? %>
                  <%= form.button analysis_button_label,
                    type: :submit,
                    name: :intent,
                    value: :analyze,
                    class: style(:primary_button),
                    data: { turbo_submits_with: t("social_context_notes.actions.analyzing") } %>
                <% else %>
                  <%= link_to t("social_context_notes.actions.review_permission"),
                    analysis_permission_path,
                    class: style(:secondary_button) %>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if editable %>
            <div class="mt-4 flex justify-end border-t border-private-line pt-4">
              <%= button_to t("social_context_notes.actions.delete"),
                note_action_path(note),
                method: :delete,
                form: { data: { turbo_confirm: t("social_context_notes.actions.delete_confirm") } },
                class: style(:danger_button) %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <% if editable %>
      <details class="group px-5 py-4 sm:px-6" <%= "open" if notes.empty? || new_note.errors.any? %>>
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-lg text-sm font-semibold text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
          <span><%= t("social_context_notes.new.title") %></span>
          <span aria-hidden="true" class="text-lg text-primary transition group-open:rotate-45">+</span>
        </summary>
        <%= form_with model: new_note, scope: :social_context_note, url: note_form_path(new_note), class: "mt-4 space-y-5 border-t border-private-line pt-4" do |form| %>
          <% if new_note.errors.any? %>
            <div id="<%= error_summary_id(new_note) %>" role="alert" class="rounded-lg border border-danger-border bg-danger-surface px-4 py-3 text-sm text-danger-ink">
              <p class="font-semibold"><%= t("social_context_notes.errors.title") %></p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% new_note.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <div>
            <%= form.label :body, t("social_context_notes.fields.body"), for: social_context_field_id(new_note, :body), class: "block text-sm font-semibold text-ink" %>
            <p class="mt-1 text-sm leading-5 text-quiet-note"><%= t("social_context_notes.fields.body_hint") %></p>
            <%= form.rich_text_area :body,
              id: social_context_field_id(new_note, :body),
              aria: ({ describedby: error_summary_id(new_note) } if new_note.errors.any?),
              class: "lexxy-content mt-2 min-h-32 w-full rounded-lg border border-stone-300 bg-canvas px-3 py-2 text-base text-ink focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" %>
          </div>
          <label class="flex min-h-11 items-start gap-3 text-sm text-ink">
            <%= form.check_box :allow_suggestions,
              { id: social_context_field_id(new_note, :allow_suggestions), class: "mt-1 size-5 rounded border-stone-300 text-primary focus:ring-primary" },
              "1", "0" %>
            <span>
              <span class="font-semibold"><%= t("social_context_notes.fields.allow_suggestions") %></span>
              <span class="mt-1 block leading-5 text-quiet-note"><%= t("social_context_notes.fields.allow_suggestions_hint") %></span>
            </span>
          </label>
          <%= form.submit t("social_context_notes.actions.add"), class: style(:primary_button), data: { turbo_submits_with: t("social_context_notes.actions.adding") } %>
        <% end %>
      </details>
    <% end %>

    <% if notes_pagy && notes_pagy.last > 1 %>
      <nav aria-label="<%= t('social_context_notes.pagination.aria_label') %>" class="flex flex-col gap-3 border-t border-private-line px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p class="text-sm text-quiet-note"><%= t("social_context_notes.pagination.info", from: notes_pagy.from, to: notes_pagy.to, count: notes_pagy.count) %></p>
        <div class="flex items-center gap-2">
          <% if notes_pagy.previous %>
            <%= link_to t("social_context_notes.pagination.previous"), notes_page_path(notes_pagy.previous), class: style(:secondary_button) %>
          <% end %>
          <span class="px-2 text-sm font-medium text-quiet-note"><%= t("social_context_notes.pagination.page", page: notes_pagy.page, pages: notes_pagy.last) %></span>
          <% if notes_pagy.next %>
            <%= link_to t("social_context_notes.pagination.next"), notes_page_path(notes_pagy.next), class: style(:secondary_button) %>
          <% end %>
        </div>
      </nav>
    <% end %>
  </div>
</section>
