<article aria-labelledby="suggestion-inspector-title" class="min-w-0 bg-white p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-900"><%= t("suggestions.types.#{suggestion.suggestion_type}.label") %></p>
      <h3 id="suggestion-inspector-title" class="mt-2 text-xl font-semibold text-stone-950"><%= suggestion.title %></h3>
    </div>
    <span class="<%= style(:certainty, certainty: suggestion.certainty.to_sym) %>"><%= t("suggestions.certainty.#{suggestion.certainty}") %></span>
  </div>

  <p class="mt-3 max-w-2xl text-sm leading-6 text-stone-700"><%= suggestion.detail %></p>

  <section class="mt-6 border-t border-stone-200 pt-5" aria-labelledby="suggestion-reasons-title">
    <h4 id="suggestion-reasons-title" class="text-sm font-semibold text-stone-950"><%= t("suggestions.inspector.why") %></h4>
    <div class="mt-3 divide-y divide-stone-200 border-y border-stone-200">
      <% suggestion.reasons.each do |reason| %>
        <div class="py-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <p class="text-sm font-medium text-stone-950"><%= reason.label %></p>
            <span class="text-xs font-semibold text-stone-600"><%= t("suggestions.certainty.#{reason.certainty}") %></span>
          </div>
          <p class="mt-2 text-sm leading-6 text-stone-700"><%= reason.evidence %></p>
          <%= link_to t("suggestions.inspector.view_source", source: source_label(reason)), source_path(reason), data: { turbo_frame: "_top" }, class: "mt-2 inline-flex text-sm font-semibold text-emerald-800 underline decoration-emerald-300 underline-offset-4 hover:text-emerald-950" %>
        </div>
      <% end %>
    </div>
  </section>

  <div class="mt-6 flex flex-wrap gap-3">
    <%= button_to t("suggestions.actions.create_reminder"),
      act_relationship_profile_suggestion_path(relationship_profile, suggestion.fingerprint),
      method: :post,
      form: { data: { turbo_frame: "_top" } },
      class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-emerald-800 px-5 py-2 text-sm font-semibold text-white hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <%= button_to t("suggestions.actions.helpful"),
      feedback_relationship_profile_suggestion_path(relationship_profile, suggestion.fingerprint),
      method: :patch,
      params: { feedback: "helpful" },
      class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
    <%= button_to t("suggestions.actions.not_for_me"),
      feedback_relationship_profile_suggestion_path(relationship_profile, suggestion.fingerprint),
      method: :patch,
      params: { feedback: "not_for_me" },
      class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-100" %>
    <%= button_to t("suggestions.actions.dismiss"),
      dismiss_relationship_profile_suggestion_path(relationship_profile, suggestion.fingerprint),
      method: :patch,
      class: "inline-flex min-h-11 items-center justify-center rounded-lg px-3 py-2 text-sm font-semibold text-stone-700 hover:bg-stone-100" %>
  </div>

  <p class="mt-4 text-xs leading-5 text-stone-600"><%= t("suggestions.inspector.reminder_disclosure") %></p>
</article>
