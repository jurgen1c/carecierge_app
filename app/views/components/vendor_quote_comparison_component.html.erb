<section aria-labelledby="vendor-quote-comparison-title">
  <div class="border-b border-private-line pb-4">
    <h2 id="vendor-quote-comparison-title" class="text-xl font-semibold text-ink"><%= t("vendor_quotes.comparison.title") %></h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("vendor_quotes.comparison.body", count: quotes.length) %></p>
  </div>

  <div role="region" aria-labelledby="vendor-quote-comparison-title" tabindex="0" class="mt-4 hidden overflow-x-auto rounded-xl border border-private-line bg-canvas focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:block">
    <table class="min-w-[72rem] w-full border-collapse text-left">
      <caption class="sr-only"><%= t("vendor_quotes.comparison.caption") %></caption>
      <thead>
        <tr class="border-b border-private-line bg-surface">
          <% %i[vendor amount status deadline scope notes next_action actions].each do |column| %>
            <th scope="col" class="px-4 py-3 text-sm font-semibold text-ink"><%= t("vendor_quotes.comparison.columns.#{column}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-private-line">
        <% quotes.each do |quote| %>
          <tr>
            <th scope="row" class="px-4 py-4 align-top text-sm font-semibold text-ink"><%= quote.vendor.name %></th>
            <td class="px-4 py-4 align-top text-sm font-semibold text-ink"><%= amount_label(quote) %></td>
            <td class="px-4 py-4 align-top"><span class="<%= style(:status_badge, status: display_status(quote).to_sym) %>"><%= status_label(quote) %></span></td>
            <td class="px-4 py-4 align-top text-sm text-quiet-note">
              <% if deadlines_for(quote).any? %>
                <dl class="space-y-2">
                  <% deadlines_for(quote).each do |kind, date| %>
                    <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.deadline_labels.#{kind}") %></dt><dd><%= deadline_label(date) %></dd></div>
                  <% end %>
                </dl>
              <% else %>
                <%= t("vendor_quotes.comparison.no_deadline") %>
              <% end %>
            </td>
            <td class="max-w-xs px-4 py-4 align-top text-sm leading-6 text-quiet-note"><%= quote.scope_details %></td>
            <td class="max-w-xs px-4 py-4 align-top text-sm leading-6 text-quiet-note"><%= quote.notes.presence || t("vendor_quotes.comparison.not_provided") %></td>
            <td class="max-w-xs px-4 py-4 align-top text-sm leading-6 text-quiet-note"><%= quote.next_action.presence || t("vendor_quotes.comparison.not_provided") %></td>
            <td class="px-4 py-2 align-top">
              <div class="flex flex-col items-start">
                <% if editable %>
                  <%= link_to t("vendor_quotes.actions.review"), edit_vendor_quote_path(quote), class: style(:text_action) %>
                  <%= link_to t("vendor_quotes.actions.reminder"), reminder_path(quote), class: style(:text_action) %>
                <% end %>
                <%= button_to t("vendor_quotes.actions.delete"), vendor_quote_path(quote), method: :delete, class: style(:danger_button), form: { data: { turbo_confirm: t("vendor_quotes.actions.delete_confirm", vendor: quote.vendor.name) } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <ul class="mt-4 divide-y divide-private-line border-y border-private-line md:hidden">
    <% quotes.each do |quote| %>
      <li class="py-4" data-mobile-quote>
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-base font-semibold text-ink"><%= quote.vendor.name %></h3>
            <p class="mt-1 text-sm font-semibold text-ink"><%= amount_label(quote) %></p>
          </div>
          <span class="<%= style(:status_badge, status: display_status(quote).to_sym) %>"><%= status_label(quote) %></span>
        </div>
        <dl class="mt-3 space-y-2 text-sm">
          <% if deadlines_for(quote).any? %>
            <% deadlines_for(quote).each do |kind, date| %>
              <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.deadline_labels.#{kind}") %></dt><dd class="mt-1 text-quiet-note"><%= deadline_label(date) %></dd></div>
            <% end %>
          <% else %>
            <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.columns.deadline") %></dt><dd class="mt-1 text-quiet-note"><%= t("vendor_quotes.comparison.no_deadline") %></dd></div>
          <% end %>
          <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.columns.scope") %></dt><dd class="mt-1 leading-6 text-quiet-note"><%= quote.scope_details %></dd></div>
          <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.columns.notes") %></dt><dd class="mt-1 leading-6 text-quiet-note"><%= quote.notes.presence || t("vendor_quotes.comparison.not_provided") %></dd></div>
          <div><dt class="font-semibold text-ink"><%= t("vendor_quotes.comparison.columns.next_action") %></dt><dd class="mt-1 leading-6 text-quiet-note"><%= quote.next_action.presence || t("vendor_quotes.comparison.not_provided") %></dd></div>
        </dl>
        <div class="mt-3 flex flex-wrap gap-2">
          <% if editable %>
            <%= link_to t("vendor_quotes.actions.review"), edit_vendor_quote_path(quote), class: style(:secondary_button) %>
            <%= link_to t("vendor_quotes.actions.reminder"), reminder_path(quote), class: style(:secondary_button) %>
          <% end %>
          <%= button_to t("vendor_quotes.actions.delete"), vendor_quote_path(quote), method: :delete, class: style(:danger_button), form: { data: { turbo_confirm: t("vendor_quotes.actions.delete_confirm", vendor: quote.vendor.name) } } %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
