<% content_for :title, t('workspace.navigation.today') %>
<% disable_turbo_cache %>
<div class="today-workspace">
  <%= component 'page_header', title: t('workspace.navigation.today'), context: l(@today.local_now.to_date, format: :long), description: t('today.introduction') do %>
    <%= component 'action_link', label: t('today.add_person'), path: new_relationship_profile_path, variant: :secondary, icon: :people %>
    <%= component 'action_link', label: t('today.add_reminder'), path: new_reminder_path, variant: :primary, icon: :plus %>
  <% end %>
  <% if @onboarding_available %>
    <section class="workspace-welcome" aria-labelledby="today-welcome">
      <div><h2 id="today-welcome"><%= t('today.welcome.title') %></h2><p><%= t('today.welcome.body') %></p></div>
      <%= component 'action_link', label: t('today.welcome.action'), path: onboarding_path, variant: :primary %>
    </section>
  <% end %>
  <div class="today-columns">
    <div class="today-agenda">
      <section class="workspace-panel" aria-labelledby="today-agenda-title">
        <header class="workspace-section-heading"><div><h2 id="today-agenda-title"><%= t('today.agenda.title') %></h2><p><%= t('today.agenda.body') %></p></div><%= component 'ui_icon', name: :reminders %></header>
        <% if @daily_feed.needs_attention.empty? && @daily_feed.later_today.empty? %>
          <div class="workspace-empty"><h3><%= t('today.agenda.quiet_title') %></h3><p><%= t('today.agenda.quiet_body') %></p><%= component 'action_link', label: t('today.agenda.quiet_action'), path: relationship_profiles_path, icon: :arrow, variant: :quiet %></div>
        <% else %>
          <% { needs_attention: @daily_feed.needs_attention, later_today: @daily_feed.later_today }.each do |section, items| %>
            <% if items.any? %>
              <div class="workspace-subheading"><h3><%= t("daily_feed.sections.#{section}") %></h3><span><%= t('today.showing', count: items.size) %></span></div>
              <div class="feed-list"><% items.each do |item| %><%= component 'daily_feed_item', item:, time_zone: @today.local_now.time_zone %><% end %></div>
            <% end %>
          <% end %>
        <% end %>
        <footer class="workspace-panel-footer"><%= component 'action_link', label: t('today.agenda.all'), path: reminders_path, variant: :quiet, icon: :arrow %></footer>
      </section>
      <% if @today.check_ins.any? %>
        <section class="workspace-panel" aria-labelledby="today-check-ins-title">
          <header class="workspace-section-heading"><div><h2 id="today-check-ins-title"><%= t('today.check_ins.title') %></h2><span class="workspace-count"><%= t('today.showing', count: @today.check_ins.size) %></span><p><%= t('today.check_ins.body') %></p></div><%= component 'ui_icon', name: :people %></header>
          <ul class="workspace-list">
            <% @today.check_ins.each do |cadence| %>
              <li class="check-in-row">
                <div><%= link_to relationship_profile_path(cadence.relationship_profile, anchor: 'contact_rhythm_section') do %><%= component 'person_identity', name: cadence.relationship_profile.display_name, subtitle: t('today.check_ins.rhythm', count: cadence.interval_days) %><% end %><p class="check-in-context"><%= cadence.last_interaction_at ? t('today.check_ins.last', date: l(cadence.last_interaction_at.in_time_zone(@today.local_now.time_zone).to_date, format: :long)) : t('today.check_ins.first') %></p></div>
                <%= component 'action_link', label: t('today.check_ins.action'), path: new_reminder_path(relationship_profile_id: cadence.relationship_profile_id) %>
              </li>
            <% end %>
          </ul>
          <footer class="workspace-panel-footer"><%= component 'action_link', label: t('today.people'), path: relationship_profiles_path, variant: :quiet, icon: :arrow %></footer>
        </section>
      <% end %>
    </div>
    <aside class="today-outlook" aria-label="<%= t('today.outlook') %>">
      <section class="workspace-panel" aria-labelledby="today-moments-title">
        <header class="workspace-section-heading"><div><h2 id="today-moments-title"><%= t('today.moments.title') %></h2><p><%= t('today.moments.body') %></p></div><%= component 'ui_icon', name: :plans %></header>
        <% if @today.plans.any? %>
          <ul class="workspace-list">
            <% @today.plans.each do |plan| %>
              <li><%= link_to event_plan_path(plan), class: 'moment-row' do %><%= component 'date_marker', date: plan.starts_on %><span class="moment-copy"><strong><%= plan.title %></strong><span><%= plan.relationship_profile.display_name %></span><span class="moment-action"><%= t('today.moments.open') %> →</span></span><% end %></li>
            <% end %>
          </ul>
          <p class="workspace-preview-note"><%= t('today.moments.preview', count: @today.plans.size, total: @today.plan_count) %></p>
        <% else %>
          <div class="workspace-empty workspace-empty-compact"><p><%= t('today.moments.empty') %></p><%= component 'action_link', label: t('today.moments.create'), path: new_event_plan_path, variant: :quiet, icon: :plus %></div>
        <% end %>
        <% if @daily_feed.coming_up.any? %>
          <div class="workspace-subheading"><h3><%= t('today.moments.dates') %></h3><span><%= t('today.showing', count: @daily_feed.coming_up.size) %></span></div>
          <div class="feed-list"><% @daily_feed.coming_up.each do |item| %><%= component 'daily_feed_item', item:, compact: true, time_zone: @today.local_now.time_zone %><% end %></div>
        <% end %>
        <footer class="workspace-panel-footer"><%= component 'action_link', label: t('today.moments.all'), path: event_plans_path, variant: :quiet, icon: :arrow %></footer>
      </section>
      <section class="workspace-panel" aria-labelledby="today-reviews-title">
        <header class="workspace-section-heading"><div><h2 id="today-reviews-title"><%= t('today.reviews.title') %></h2><p><%= t('today.reviews.body') %></p></div><%= component 'ui_icon', name: :reviews %></header>
        <div class="workspace-empty workspace-empty-compact"><p><%= t('today.reviews.waiting', count: @today.review_count) %></p><%= component 'action_link', label: t('today.reviews.action'), path: approvals_path, variant: :quiet, icon: :arrow %></div>
      </section>
      <%= link_to relationship_profiles_path, class: 'today-people-link' do %><%= component 'ui_icon', name: :people %><span><strong><%= t('today.relationship_count', count: @today.profile_count) %></strong><span><%= t('today.people') %></span></span><%= component 'ui_icon', name: :arrow %><% end %>
    </aside>
    <div class="today-ideas">
      <% if @daily_feed.ideas.any? %>
        <section class="workspace-panel" aria-labelledby="today-ideas-title">
          <header class="workspace-section-heading"><div><h2 id="today-ideas-title"><%= t('today.ideas.title') %></h2><p><%= t('today.ideas.body') %></p></div><span class="workspace-count"><%= t('today.showing', count: @daily_feed.ideas.size) %></span></header>
          <div class="feed-list"><% @daily_feed.ideas.each do |item| %><%= component 'daily_feed_item', item:, time_zone: @today.local_now.time_zone %><% end %></div>
          <footer class="workspace-panel-footer"><%= component 'action_link', label: t('today.ideas.all'), path: relationship_profiles_path, variant: :quiet, icon: :arrow %></footer>
        </section>
      <% end %>
    </div>
  </div>
</div>
