<% content_for :title, t("data_controls.show.page_title") %>
<% disable_turbo_cache %>

<main class="flex flex-1 flex-col gap-8 py-8">
  <header class="border-b border-stone-200 pb-6">
    <%= link_to t("data_controls.show.back"), dashboard_path, class: "inline-flex min-h-11 items-center text-sm font-semibold text-emerald-800 hover:text-emerald-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
    <h1 class="mt-3 text-3xl font-semibold text-stone-950"><%= t("data_controls.show.heading") %></h1>
    <p class="mt-3 max-w-3xl text-base leading-7 text-stone-700"><%= t("data_controls.show.body") %></p>
  </header>

  <section aria-labelledby="exports-heading" class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
    <div class="border-b border-stone-200 px-5 py-5 sm:px-6">
      <h2 id="exports-heading" class="text-xl font-semibold text-stone-950"><%= t("data_controls.show.exports.title") %></h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700"><%= t("data_controls.show.exports.body") %></p>
    </div>

    <div class="grid divide-y divide-stone-200 lg:grid-cols-2 lg:divide-x lg:divide-y-0">
      <%= form_with url: data_exports_path, scope: :data_export, namespace: :account_export, class: "grid content-start gap-4 p-5 sm:p-6" do |form| %>
        <%= form.hidden_field :scope, value: "account" %>
        <div>
          <h3 class="text-base font-semibold text-stone-950"><%= t("data_controls.show.exports.account_title") %></h3>
          <p class="mt-1 text-sm leading-6 text-stone-700"><%= t("data_controls.show.exports.account_body") %></p>
        </div>
        <div>
          <%= form.label :format, t("data_controls.show.exports.format"), class: "block text-sm font-medium text-stone-800" %>
          <%= form.select :format, [["JSON", "json"], ["CSV", "csv"], ["PDF", "pdf"], [t("data_controls.show.exports.calendar"), "ics"]], {}, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>
        <label class="flex items-start gap-3 text-sm text-stone-800">
          <%= form.check_box :include_sensitive, class: "mt-1 size-4 rounded border-stone-300 text-emerald-800 focus:ring-emerald-700" %>
          <span><span class="font-semibold"><%= t("data_controls.show.exports.include_sensitive") %></span><br><span class="leading-6 text-stone-700"><%= t("data_controls.show.exports.include_sensitive_body") %></span></span>
        </label>
        <div>
          <%= form.label :current_password, t("data_controls.show.current_password"), class: "block text-sm font-medium text-stone-800" %>
          <%= form.password_field :current_password, autocomplete: "current-password", class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>
        <%= form.submit t("data_controls.show.exports.account_action"), class: "min-h-11 w-fit cursor-pointer rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>

      <%= form_with url: data_exports_path, scope: :data_export, namespace: :profile_export, class: "grid content-start gap-4 p-5 sm:p-6" do |form| %>
        <%= form.hidden_field :scope, value: "relationship_profile" %>
        <div>
          <h3 class="text-base font-semibold text-stone-950"><%= t("data_controls.show.exports.profile_title") %></h3>
          <p class="mt-1 text-sm leading-6 text-stone-700"><%= t("data_controls.show.exports.profile_body") %></p>
        </div>
        <div>
          <%= form.label :relationship_profile_id, t("data_controls.show.exports.profile"), class: "block text-sm font-medium text-stone-800" %>
          <%= form.collection_select :relationship_profile_id, @relationship_profiles, :id, :display_name, {}, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>
        <div>
          <%= form.label :format, t("data_controls.show.exports.format"), class: "block text-sm font-medium text-stone-800" %>
          <%= form.select :format, [["JSON", "json"], ["CSV", "csv"], ["PDF", "pdf"], [t("data_controls.show.exports.calendar"), "ics"]], {}, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>
        <label class="flex items-start gap-3 text-sm text-stone-800">
          <%= form.check_box :include_sensitive, class: "mt-1 size-4 rounded border-stone-300 text-emerald-800 focus:ring-emerald-700" %>
          <span><span class="font-semibold"><%= t("data_controls.show.exports.include_sensitive") %></span><br><span class="leading-6 text-stone-700"><%= t("data_controls.show.exports.include_sensitive_body") %></span></span>
        </label>
        <div>
          <%= form.label :current_password, t("data_controls.show.current_password"), class: "block text-sm font-medium text-stone-800" %>
          <%= form.password_field :current_password, autocomplete: "current-password", class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20" %>
        </div>
        <%= form.submit t("data_controls.show.exports.profile_action"), disabled: @relationship_profiles.empty?, class: "min-h-11 w-fit cursor-pointer rounded-lg bg-emerald-800 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 disabled:cursor-not-allowed disabled:bg-stone-300" %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="delete-specific-heading" class="rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
    <h2 id="delete-specific-heading" class="text-xl font-semibold text-stone-950"><%= t("data_controls.show.delete_specific.title") %></h2>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700"><%= t("data_controls.show.delete_specific.body") %></p>
    <div class="mt-5 flex flex-wrap gap-3">
      <%= link_to t("data_controls.show.delete_specific.profiles"), relationship_profiles_path, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% if @relationship_profiles.any? %>
        <%= link_to t("data_controls.show.delete_specific.sensitive"), relationship_profile_privacy_vault_path(@relationship_profiles.first), class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-stone-900 hover:bg-stone-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
      <% end %>
    </div>
  </section>

  <section aria-labelledby="danger-heading" class="overflow-hidden rounded-2xl border border-red-200 bg-white">
    <div class="border-b border-red-200 bg-red-50 px-5 py-5 sm:px-6">
      <h2 id="danger-heading" class="text-xl font-semibold text-red-950"><%= t("data_controls.show.danger.title") %></h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-red-900"><%= t("data_controls.show.danger.body") %></p>
    </div>

    <div class="divide-y divide-stone-200">
      <%= form_with url: data_deletions_path, scope: :data_deletion, namespace: :ai_deletion, class: "grid gap-4 p-5 sm:grid-cols-[1fr_minmax(15rem,22rem)] sm:p-6" do |form| %>
        <%= form.hidden_field :kind, value: "ai_generated" %>
        <div>
          <h3 class="text-base font-semibold text-stone-950"><%= t("data_controls.show.delete_ai.title") %></h3>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-stone-700"><%= t("data_controls.show.delete_ai.body") %></p>
        </div>
        <div class="grid content-start gap-3">
          <%= form.label :confirmation, t("data_controls.show.confirmation", email: current_user.email), class: "text-sm font-medium text-stone-800" %>
          <%= form.email_field :confirmation, required: true, autocomplete: "off", class: "min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-red-700 focus:outline-none focus:ring-2 focus:ring-red-700/20" %>
          <%= form.submit t("data_controls.show.delete_ai.action"), data: { turbo_confirm: t("data_controls.show.delete_ai.confirm") }, class: "min-h-11 cursor-pointer rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-800 hover:bg-red-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
        </div>
      <% end %>

      <%= form_with url: data_deletions_path, scope: :data_deletion, namespace: :account_deletion, class: "grid gap-4 p-5 sm:grid-cols-[1fr_minmax(15rem,22rem)] sm:p-6" do |form| %>
        <%= form.hidden_field :kind, value: "account" %>
        <div>
          <h3 class="text-base font-semibold text-red-950"><%= t("data_controls.show.delete_account.title") %></h3>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-stone-700"><%= t("data_controls.show.delete_account.body") %></p>
        </div>
        <div class="grid content-start gap-3">
          <%= form.label :confirmation, t("data_controls.show.confirmation", email: current_user.email), class: "text-sm font-medium text-stone-800" %>
          <%= form.email_field :confirmation, required: true, autocomplete: "off", class: "min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-red-700 focus:outline-none focus:ring-2 focus:ring-red-700/20" %>
          <%= form.label :current_password, t("data_controls.show.current_password"), class: "text-sm font-medium text-stone-800" %>
          <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "min-h-11 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-base text-stone-950 focus:border-red-700 focus:outline-none focus:ring-2 focus:ring-red-700/20" %>
          <% if current_user.provider.present? %>
            <p class="text-sm leading-6 text-stone-700">
              <%= t("data_controls.show.delete_account.oauth_password_help") %>
              <%= link_to t("data_controls.show.delete_account.set_password_action"), new_user_password_path, class: "font-semibold text-emerald-800 underline decoration-emerald-300 underline-offset-4 hover:text-emerald-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700" %>
            </p>
          <% end %>
          <%= form.submit t("data_controls.show.delete_account.action"), data: { turbo_confirm: t("data_controls.show.delete_account.confirm") }, class: "min-h-11 cursor-pointer rounded-lg bg-red-800 px-4 py-2 text-sm font-semibold text-white hover:bg-red-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
