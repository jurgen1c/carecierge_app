<% disable_turbo_cache %>
<div class="w-full">
  <%= component "page_header", title: t("event_plans.index.title"), description: t("event_plans.index.body") do %>
    <%= component "action_link", label: t("event_plans.index.booking_history"), path: bookings_path, variant: :secondary %>
    <%= component "action_link", label: t("event_plans.index.create"), path: new_event_plan_path, variant: :primary, icon: "plus" %>
  <% end %>

  <% if @event_plans.any? %>
    <ul class="plan-directory">
      <% @event_plans.each do |plan| %>
        <li class="workspace-panel">
          <%= link_to event_plan_path(plan), class: "plan-directory-link" do %>
            <span class="plan-directory-title"><strong><%= plan.title %></strong><span><%= plan.occasion_type_label %></span></span>
            <span class="plan-directory-person"><%= component "person_identity", name: plan.relationship_profile.display_name, subtitle: plan.relationship_profile.relationship_type_label %></span>
            <span class="plan-directory-date"><% if plan.starts_on %><%= component "date_marker", date: plan.starts_on %><span><%= l(plan.starts_on, format: :long) %></span><% else %><%= t("event_plans.workspace.unscheduled") %><% end %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <section class="mt-8 rounded-2xl border border-private-line bg-surface p-6" aria-labelledby="event-plans-empty-title">
      <h2 id="event-plans-empty-title" class="text-xl font-semibold text-ink"><%= t("event_plans.index.empty_title") %></h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("event_plans.index.empty_body") %></p>
      <%= link_to t("event_plans.index.empty_action"), new_event_plan_path, class: "mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-primary" %>
    </section>
  <% end %>
</div>
