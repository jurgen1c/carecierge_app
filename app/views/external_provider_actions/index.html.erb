<% disable_turbo_cache %>
<main aria-labelledby="provider-history-title" class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
  <%= link_to @relationship_profile.display_name, relationship_profile_path(@relationship_profile), class: "inline-flex min-h-11 items-center text-primary underline" %>
  <header class="border-b border-private-line py-5">
    <h1 id="provider-history-title" class="text-3xl font-semibold text-ink"><%= t("external_provider_actions.title") %></h1>
    <p class="mt-3 max-w-2xl text-base leading-7 text-quiet-note"><%= t("external_provider_actions.manual") %></p>
    <% if @relationship_profile.kept? %><%= link_to t("external_provider_actions.add"), new_relationship_profile_external_provider_action_path(@relationship_profile), class: "mt-4 inline-flex min-h-11 items-center rounded-lg bg-primary px-5 py-3 font-semibold text-canvas hover:bg-primary-hover" %><% end %>
  </header>
  <% if @records.empty? %><p class="py-8 leading-7 text-quiet-note"><%= t("external_provider_actions.empty") %></p><% end %>
  <% @records.each do |record| %><%= component "external_provider_action", record:, time_zone: current_user.notification_preference&.time_zone.presence || "UTC" %><% end %>
  <% if @pagy.last > 1 %>
    <nav aria-label="<%= t("external_provider_actions.pagination") %>" class="flex justify-between gap-4 py-5">
      <% if @pagy.previous %><%= link_to t("external_provider_actions.previous"), url_for(request.query_parameters.merge(page: @pagy.previous)), class: "inline-flex min-h-11 items-center text-primary underline" %><% end %>
      <% if @pagy.next %><%= link_to t("external_provider_actions.next"), url_for(request.query_parameters.merge(page: @pagy.next)), class: "inline-flex min-h-11 items-center text-primary underline" %><% end %>
    </nav>
  <% end %>
</main>
