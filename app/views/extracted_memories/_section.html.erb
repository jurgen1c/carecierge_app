<% pending_memories = extracted_memories.select(&:pending?) %>
<% active_recap = conversation_recaps.find { |recap| recap.extraction_status.in?(%w[requested processing failed]) } %>

<section id="memory-review" class="rounded-2xl border border-stone-200 bg-stone-50/70 p-5 shadow-sm shadow-stone-200/40" aria-labelledby="memory-review-title">
  <div class="flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold text-emerald-800"><%= t("extracted_memories.section.kicker") %></p>
      <h2 id="memory-review-title" class="mt-2 text-xl font-semibold text-stone-950"><%= t("extracted_memories.section.title") %></h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700"><%= t("extracted_memories.section.body") %></p>
    </div>
    <span class="inline-flex w-fit items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-950"><%= t("extracted_memories.section.pending_count", count: pending_memories.size) %></span>
  </div>

  <% if pending_memories.any? %>
    <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(16rem,0.75fr)_minmax(0,1.25fr)]">
      <nav aria-label="<%= t("extracted_memories.section.queue_label") %>" class="rounded-xl border border-stone-200 bg-white p-3">
        <ol class="grid gap-2">
          <% pending_memories.each do |memory| %>
            <li>
              <%= link_to relationship_profile_path(relationship_profile, memory_proposal: memory.id, anchor: "memory-review"),
                aria: { current: memory == selected_extracted_memory ? "true" : nil },
                class: "block min-h-11 rounded-lg border border-stone-200 px-4 py-3 transition hover:border-emerald-300 hover:bg-emerald-50/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700 aria-[current=true]:border-emerald-600 aria-[current=true]:bg-emerald-50" do %>
                <span class="block text-xs font-semibold text-emerald-800"><%= memory.category_label %></span>
                <span class="mt-1 block text-sm font-semibold text-stone-950"><%= memory.title %></span>
                <span class="mt-1 block text-xs text-stone-600"><%= memory.confidence_label %></span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </nav>

      <%= component "extracted_memory_review", extracted_memory: selected_extracted_memory, relationship_profile: %>
    </div>
  <% elsif active_recap&.extraction_status.in?(%w[requested processing]) %>
    <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-5" role="status">
      <h3 class="text-base font-semibold text-amber-950"><%= t("extracted_memories.section.processing_title") %></h3>
      <p class="mt-2 text-sm leading-6 text-amber-900"><%= t("extracted_memories.section.processing_body") %></p>
    </div>
  <% elsif active_recap&.extraction_status == "failed" %>
    <div class="mt-5 rounded-xl border border-red-200 bg-red-50 p-5" role="alert">
      <h3 class="text-base font-semibold text-red-950"><%= t("extracted_memories.section.failed_title") %></h3>
      <p class="mt-2 text-sm leading-6 text-red-900"><%= t("extracted_memories.section.failed_body") %></p>
      <%= button_to t("extracted_memories.section.retry"), retry_extraction_relationship_profile_conversation_recap_path(relationship_profile, active_recap),
        method: :patch,
        class: "mt-4 inline-flex min-h-11 items-center justify-center rounded-lg border border-red-300 bg-white px-5 py-3 text-sm font-semibold text-red-950 transition hover:bg-red-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700" %>
    </div>
  <% elsif extracted_memories.any? %>
    <div class="mt-5 rounded-xl border border-emerald-200 bg-emerald-50 p-5">
      <h3 class="text-base font-semibold text-emerald-950"><%= t("extracted_memories.section.complete_title") %></h3>
      <p class="mt-2 text-sm leading-6 text-emerald-900"><%= t("extracted_memories.section.complete_body") %></p>
    </div>
  <% else %>
    <div class="mt-5 rounded-xl border border-dashed border-stone-300 bg-white p-5">
      <h3 class="text-base font-semibold text-stone-950"><%= t("extracted_memories.section.empty_title") %></h3>
      <p class="mt-2 text-sm leading-6 text-stone-700"><%= t("extracted_memories.section.empty_body") %></p>
    </div>
  <% end %>
</section>
