<main aria-labelledby="marketplace-title" class="mx-auto max-w-6xl px-4 py-6 sm:px-6">
  <header class="space-y-3 border-b border-private-line pb-6">
    <h1 id="marketplace-title" class="text-3xl font-semibold text-ink"><%= t("marketplace.title") %></h1>
    <p class="max-w-prose leading-7 text-quiet-note"><%= t("marketplace.intro") %></p>
    <%= link_to t("marketplace.my_vendors"), vendors_path, class: "inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4" %>
  </header>
  <%= search_form_for @query, url: marketplace_listings_path, class: "grid gap-4 border-b border-private-line py-6 sm:grid-cols-2" do |form| %>
    <% { name_or_curated_summary_cont: "search", service_area_cont: "area", relationship_use_cases_cont: "use_cases" }.each do |field, label| %>
      <div>
        <%= form.label field, t("marketplace.#{label}"), class: "block text-sm font-semibold text-ink" %>
        <%= form.search_field field, maxlength: 200, class: "mt-2 min-h-11 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-ink" %>
      </div>
    <% end %>
    <div>
      <%= form.label :category_eq, t("vendors.search.category"), class: "block text-sm font-semibold text-ink" %>
      <%= form.select :category_eq, Vendor::CATEGORIES.map { |category| [t("vendors.categories.#{category}"), category] }, { include_blank: t("vendors.search.any_category") }, class: "mt-2 min-h-11 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-ink" %>
    </div>
    <div>
      <%= label_tag :occasion, t("vendors.search.occasion"), class: "block text-sm font-semibold text-ink" %>
      <%= select_tag :occasion, options_for_select(EventPlan::OCCASION_TYPES.map { |occasion| [t("event_plans.occasion_types.#{occasion}"), occasion] }, @occasion), include_blank: t("vendors.search.any_occasion"), class: "mt-2 min-h-11 w-full rounded-lg border border-private-line bg-canvas px-3 py-2 text-ink" %>
    </div>
    <div class="flex flex-wrap items-end gap-3">
      <%= form.submit t("marketplace.search_action"), class: "min-h-11 rounded-lg bg-primary px-5 py-3 font-semibold text-canvas hover:bg-primary-hover" %>
      <%= link_to t("vendors.search.clear"), marketplace_listings_path, class: "inline-flex min-h-11 items-center px-3 font-semibold text-primary underline" %>
    </div>
  <% end %>
  <% if @listings.any? %>
    <%= form_with url: compare_marketplace_listings_path, method: :get do |form| %>
      <fieldset>
        <legend class="pt-5 text-sm font-semibold text-ink"><%= t("marketplace.compare_hint") %></legend>
        <ol class="divide-y divide-private-line">
          <% @listings.each do |listing| %>
            <li class="py-3">
              <label class="inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-ink">
                <%= check_box_tag "listing_ids[]", listing.id, Array(@selected_listing_ids).include?(listing.id), id: "compare_#{listing.id}", class: "h-5 w-5 accent-primary" %>
                <%= t("marketplace.select", name: listing.name) %>
              </label>
              <%= component "marketplace_listing", listing: %>
            </li>
          <% end %>
        </ol>
      </fieldset>
      <%= form.submit t("marketplace.compare"), class: "min-h-11 rounded-lg bg-primary px-5 py-3 font-semibold text-canvas hover:bg-primary-hover" %>
    <% end %>
  <% else %>
    <section class="py-10">
      <h2 class="text-xl font-semibold text-ink"><%= t("marketplace.empty_title") %></h2>
      <p class="mt-3 max-w-prose leading-7 text-quiet-note"><%= t("marketplace.empty_body") %></p>
    </section>
  <% end %>
  <% if @pagy.last > 1 %>
    <nav aria-label="<%= t('vendors.pagination.label') %>" class="flex flex-wrap gap-4 py-5">
      <% if @pagy.previous %><%= link_to t("vendors.pagination.previous"), url_for(request.query_parameters.merge("page" => @pagy.previous)), class: "inline-flex min-h-11 items-center font-semibold text-primary underline" %><% end %>
      <span class="py-3 text-sm text-quiet-note"><%= t("vendors.pagination.page", page: @pagy.page, pages: @pagy.last) %></span>
      <% if @pagy.next %><%= link_to t("vendors.pagination.next"), url_for(request.query_parameters.merge("page" => @pagy.next)), class: "inline-flex min-h-11 items-center font-semibold text-primary underline" %><% end %>
    </nav>
  <% end %>
  <p class="mt-6 border-t border-private-line pt-5 text-sm leading-6 text-quiet-note"><%= t("marketplace.safety") %></p>
</main>
