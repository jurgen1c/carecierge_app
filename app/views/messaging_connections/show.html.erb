<% content_for :title, t("messaging.heading") %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<main class="flex flex-1 flex-col py-6">
  <%= link_to t("messaging.back"), dashboard_path, class: "mb-5 inline-flex min-h-11 w-fit items-center text-sm font-semibold text-quiet-note hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" %>
  <%= component "messaging_connection", connection: @connection, contexts: @contexts, provider_available: @provider_available, results: @results, page: @page, more: @more %>
</main>
