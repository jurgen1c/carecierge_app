<%= turbo_frame_tag "relationship_persona_section" do %>
<section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm shadow-stone-200/40" aria-labelledby="relationship-persona-title">
  <header class="border-b border-stone-200 pb-5">
    <p class="text-sm font-semibold text-emerald-800"><%= t("relationship_personas.section.kicker") %></p>
    <h2 id="relationship-persona-title" class="mt-2 text-xl font-semibold text-stone-950"><%= t("relationship_personas.section.title") %></h2>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700"><%= t("relationship_personas.section.body", name: relationship_profile.display_name) %></p>
    <% if relationship_persona.traits.any? %>
      <p class="mt-2 max-w-3xl text-sm font-medium leading-6 text-stone-800"><%= t("relationship_personas.section.summary", traits: relationship_persona.summary) %></p>
    <% end %>
  </header>

  <% if relationship_persona.traits.any? %>
    <div class="mt-1">
      <% relationship_persona.traits.each do |trait| %>
        <%= component "persona_trait", trait:, relationship_profile: %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-5 rounded-lg border border-dashed border-stone-300 bg-stone-50 px-4 py-5">
      <p class="text-sm font-semibold text-stone-950"><%= t("relationship_personas.section.empty_title") %></p>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-stone-700"><%= t("relationship_personas.section.empty_body") %></p>
    </div>
  <% end %>
</section>
<% end %>
