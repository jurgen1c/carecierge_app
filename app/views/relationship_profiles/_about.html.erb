  <p class="max-w-prose text-sm leading-6 text-quiet-note"><%= t("profile_workspace.about_hint") %> <%= component "action_link", label: t("relationship_profiles.show.edit"), path: edit_relationship_profile_path(@relationship_profile), variant: :quiet %></p>
  <section class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr]">
    <article class="min-w-0">
      <% if @relationship_profile.birthday.present? || @relationship_profile.pronouns.present? || @relationship_profile.public_notes.any? || @relationship_profile.private_notes.any? %><h2 class="text-base font-semibold text-stone-950"><%= t("relationship_profiles.show.details_title") %></h2><% end %>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <% if @relationship_profile.birthday.present? %><div>
          <dt class="text-sm font-medium text-stone-700"><%= t("relationship_profiles.show.birthday") %></dt>
          <dd class="mt-1 text-sm text-stone-950"><%= l(@relationship_profile.birthday, format: :long) %></dd>
        </div><% end %>
        <% if @relationship_profile.pronouns.present? %><div>
          <dt class="text-sm font-medium text-stone-700"><%= t("relationship_profiles.show.pronouns") %></dt>
          <dd class="mt-1 text-sm text-stone-950"><%= @relationship_profile.pronouns.presence || t("relationship_profiles.show.not_provided") %></dd>
        </div><% end %>
      </dl>

      <% if @relationship_profile.public_notes.any? %><div class="mt-6">
        <h3 class="text-sm font-semibold text-stone-950"><%= t("relationship_profiles.show.notes") %></h3>
        <% if @relationship_profile.public_notes.any? %>
          <div class="mt-2 grid gap-3">
            <% @relationship_profile.public_notes.each do |note| %>
              <div class="lexxy-content text-sm leading-6 text-stone-700"><%= note.body %></div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-2 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </div><% end %>

      <% if @relationship_profile.private_notes.any? %><div class="mt-6 border-l-2 border-private-line pl-4">
        <h3 class="text-sm font-semibold text-stone-950"><%= t("relationship_profiles.show.private_notes") %></h3>
        <% if @relationship_profile.private_notes.any? %>
          <div class="mt-2 grid gap-3">
            <% @relationship_profile.private_notes.each do |note| %>
              <div class="lexxy-content text-sm leading-6 text-stone-700"><%= note.body %></div>
            <% end %>
          </div>
        <% else %>
          <p class="mt-2 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </div><% end %>
    </article>

    <aside class="flex flex-col gap-5">

      <% if @relationship_profile.relationship_preferences.any? %>
      <section class="min-w-0">
        <h2 class="text-base font-semibold text-stone-950"><%= t("profile_workspace.preferences") %></h2>
        <% if @relationship_profile.relationship_preferences.any? %>
          <div class="mt-4 space-y-4">
            <% @relationship_profile.relationship_preferences.sort_by { |preference| [ preference.category_label, preference.key.downcase ] }.each do |preference| %>
              <article id="<%= dom_id(preference, :persona_source) %>" class="border-t border-private-line py-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-900"><%= preference.preference_type_label %></span>
                  <span class="rounded-full bg-white px-3 py-1 text-xs font-medium text-stone-700"><%= preference.category_label %></span>
                </div>
                <h3 class="mt-3 text-sm font-semibold text-stone-950"><%= preference.key %></h3>
                <p class="mt-1 text-sm leading-6 text-stone-700"><%= preference.value %></p>
                <dl class="mt-3 grid gap-2 text-xs text-stone-700">
                  <div>
                    <dt class="font-semibold text-stone-800"><%= t("relationship_profiles.show.preference_confidence") %></dt>
                    <dd class="mt-1"><%= preference.confidence_label %></dd>
                  </div>
                  <% if preference.learned_on.present? %>
                    <div>
                      <dt class="font-semibold text-stone-800"><%= t("relationship_profiles.show.preference_learned_on") %></dt>
                      <dd class="mt-1"><%= l(preference.learned_on, format: :relationship_preference_learned_on) %></dd>
                    </div>
                  <% end %>
                  <% if preference.source_notes.present? %>
                    <div>
                      <dt class="font-semibold text-stone-800"><%= t("relationship_profiles.show.preference_source_notes") %></dt>
                      <dd class="mt-1 leading-5"><%= preference.source_notes %></dd>
                    </div>
                  <% end %>
                </dl>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </section>
      <% end %>

      <% if @relationship_profile.visible_relationship_field_values.any? %>
      <section class="min-w-0">
        <h2 class="text-base font-semibold text-stone-950"><%= t("profile_workspace.details") %></h2>
        <% visible_relationship_field_values = @relationship_profile.visible_relationship_field_values %>
        <% if visible_relationship_field_values.any? %>
          <dl class="mt-4 space-y-3">
            <% visible_relationship_field_values.each do |field_value| %>
              <div>
                <dt class="text-sm font-medium text-stone-700"><%= field_value.display_label %></dt>
                <dd class="mt-1 whitespace-pre-line text-sm text-stone-950"><%= field_value.value %></dd>
              </div>
            <% end %>
          </dl>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </section>
      <% end %>

      <% if @relationship_profile.relationship_tags.any? %>
      <section class="min-w-0">
        <h2 class="text-base font-semibold text-stone-950"><%= t("relationship_profiles.show.tags_title") %></h2>
        <% if @relationship_profile.relationship_tags.any? %>
          <div class="mt-4 flex flex-wrap gap-2">
            <% @relationship_profile.relationship_tags.each do |tag| %>
              <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-700"><%= tag.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </section>
      <% end %>

      <% if @relationship_profile.relationship_groups.any? %>
      <section class="min-w-0">
        <h2 class="text-base font-semibold text-stone-950"><%= t("relationship_profiles.show.groups_title") %></h2>
        <% if @relationship_profile.relationship_groups.any? %>
          <div class="mt-4 flex flex-wrap gap-2">
            <% @relationship_profile.relationship_groups.each do |group| %>
              <span class="rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-900"><%= group.name %></span>
            <% end %>
          </div>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-stone-700"><%= t("relationship_profiles.show.not_provided") %></p>
        <% end %>
      </section>
      <% end %>
    </aside>
  </section>
