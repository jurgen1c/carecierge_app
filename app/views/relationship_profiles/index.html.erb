<% content_for :title, t("people.title") %>
<% disable_turbo_cache %>
<div class="people-workspace">
  <%= component "page_header", title: t("people.title"), description: t("people.description") do %>
    <%= component "action_link", label: t(".new_profile"), path: new_relationship_profile_path, variant: :primary, icon: "plus" %>
  <% end %>

  <%= form_with url: relationship_profiles_path, method: :get, class: "people-search" do %>
    <div class="people-search-row">
      <div>
        <%= label_tag "q[#{RelationshipProfile::SearchQuery::SEARCH_PREDICATE}]", t(".search_label"), class: "people-field-label" %>
        <%= text_field_tag "q[#{RelationshipProfile::SearchQuery::SEARCH_PREDICATE}]", @search_query, placeholder: t(".search_placeholder"), class: "people-input" %>
      </div>
      <%= submit_tag t("people.search"), class: "workspace-action workspace-action-secondary" %>
    </div>
    <details data-people-filters <%= "open" if @status != "active" || @tag_id.present? || @group_id.present? %>>
      <summary><%= t("people.filters") %></summary>
      <div class="people-filter-fields">
        <div>
          <%= label_tag :status, t(".status_label"), class: "people-field-label" %>
          <%= select_tag :status, options_for_select([[t(".statuses.active"), "active"], [t(".statuses.archived"), "archived"], [t(".statuses.all"), "all"]], @status), class: "people-input" %>
        </div>
        <div>
          <%= label_tag :tag_id, t(".tag_label"), class: "people-field-label" %>
          <%= select_tag :tag_id, options_from_collection_for_select(@relationship_tags, :id, :name, @tag_id), include_blank: t(".all_tags"), class: "people-input" %>
        </div>
        <div>
          <%= label_tag :group_id, t(".group_label"), class: "people-field-label" %>
          <%= select_tag :group_id, options_from_collection_for_select(@relationship_groups, :id, :name, @group_id), include_blank: t(".all_groups"), class: "people-input" %>
        </div>
        <%= submit_tag t(".apply_filters"), class: "workspace-action workspace-action-secondary" %>
      </div>
    </details>
  <% end %>

  <div class="people-results-heading">
    <p role="status"><%= t("people.results", count: @pagy.count) %></p>
    <%= component "action_link", label: t(".search_memory"), path: relationship_search_path, variant: :quiet %>
  </div>
  <% if @relationship_profiles.any? %>
    <section aria-label="<%= t(".profiles_label") %>" class="people-grid">
      <% @relationship_profiles.each do |profile| %>
        <%= component "person_card", profile:, summaries: @people_summaries %>
      <% end %>
    </section>
    <% if @pagy.pages > 1 %>
      <nav class="people-pagination" aria-label="<%= t("people.pagination") %>">
        <% if @pagy.previous %><%= link_to t("people.previous"), relationship_profiles_path(q: @search_params, status: @status, tag_id: @tag_id, group_id: @group_id, page: @pagy.previous), rel: "prev", class: "workspace-action workspace-action-secondary" %><% end %>
        <span><%= t("people.page", page: @pagy.page, pages: @pagy.pages) %></span>
        <% if @pagy.next %><%= link_to t("people.next"), relationship_profiles_path(q: @search_params, status: @status, tag_id: @tag_id, group_id: @group_id, page: @pagy.next), rel: "next", class: "workspace-action workspace-action-secondary" %><% end %>
      </nav>
    <% end %>
  <% else %>
    <section class="workspace-panel workspace-empty">
      <h2 class="text-lg font-semibold"><%= t("people.empty_title") %></h2>
      <p><%= t("people.empty_body") %></p>
      <%= component "action_link", label: t(".new_profile"), path: new_relationship_profile_path %>
      <%= component "action_link", label: t("people.clear_filters"), path: relationship_profiles_path, variant: :quiet %>
    </section>
  <% end %>
</div>
