<% content_for :title, @relationship_profile.display_name %>
<% disable_turbo_cache %>
<div class="profile-workspace" data-controller="profile-workspace" data-action="hashchange@window->profile-workspace#revealLocation turbo:load@document->profile-workspace#revealLocation turbo:frame-load->profile-workspace#revealFrame">
  <%= component "action_link", label: t("profile_workspace.back"), path: relationship_profiles_path, variant: :quiet %>
  <header class="profile-header">
    <div>
      <h1><%= component "person_identity", name: @relationship_profile.display_name, subtitle: @relationship_profile.relationship_type_label, size: :large %></h1>
      <% if @relationship_profile.full_name != @relationship_profile.display_name %><p class="profile-full-name"><%= @relationship_profile.full_name %></p><% end %>
      <% if @relationship_profile.archived? %><p class="profile-full-name"><%= t("relationship_profiles.index.archived") %></p><% end %>
    </div>
    <div class="workspace-actions profile-primary-actions">
      <%= component "action_link", label: t("profile_workspace.record"), path: new_relationship_profile_interaction_path(@relationship_profile), variant: :primary, icon: "plus" %>
      <%= component "action_link", label: t("profile_workspace.remind"), path: new_reminder_path(relationship_profile_id: @relationship_profile.id), variant: :secondary %>
      <%= component "action_link", label: t("relationship_profiles.show.edit"), path: edit_relationship_profile_path(@relationship_profile), variant: :quiet %>
    </div>
  </header>
  <% if Array(@relationship_profile.profile_attributes["contacts_sources"]).any? %>
    <p class="mb-5 text-sm text-quiet-note"><%= t("contacts.profile_source") %> <%= link_to t("contacts.heading"), contacts_connection_path, class: "workspace-action workspace-action-quiet" %></p>
  <% end %>
  <%= component "professional_context", relationship_profile: @relationship_profile if @relationship_profile.professional? %>
  <div class="profile-columns">
    <aside class="profile-overview">
      <%= render "relationship_profiles/overview", relationship_profile: @relationship_profile, interactions: @interactions %>
      <%= render "important_dates/upcoming", relationship_profile: @relationship_profile %>
      <nav class="profile-section-nav" aria-label="<%= t("profile_workspace.navigation") %>">
        <% profile_workspace_sections.each do |section| %>
          <%= link_to t("profile_workspace.sections.#{section}.title"), relationship_profile_path(@relationship_profile, section:, anchor: "profile-#{section}"), class: "workspace-action workspace-action-quiet" %>
        <% end %>
      </nav>
    </aside>
    <div class="profile-sections">
      <%= component "profile_section", section: "moments", expanded: profile_section_expanded?("moments") do %>
  <%= render "important_dates/section", relationship_profile: @relationship_profile %>
  <%= render "contact_cadences/section", relationship_profile: @relationship_profile, interactions: @interactions %>
      <% end %>
      <%= component "profile_section", section: "plans", context: profile_work_preview, expanded: profile_section_expanded?("plans") do %>
  <%= render "reminders/section", relationship_profile: @relationship_profile, reminders: @relationship_reminders %>
  <%= render "event_plans/relationship_section", relationship_profile: @relationship_profile %>
  <%= render "commitments/section", relationship_profile: @relationship_profile, selected_type: @timeline_type %>
  <%= render "desires/section", relationship_profile: @relationship_profile %>
  <%= render "gifts/section", relationship_profile: @relationship_profile %>
  <div class="workspace-actions">
    <%= component "action_link", label: t("gift_boxes.title"), path: relationship_profile_gift_boxes_path(@relationship_profile), variant: :secondary %>
    <%= component "action_link", label: t("external_provider_actions.title"), path: relationship_profile_external_provider_actions_path(@relationship_profile), variant: :secondary %>
  </div>
      <% end %>
      <%= component "profile_section", section: "notes", expanded: profile_section_expanded?("notes") do %>
  <%= render "conversation_recaps/section", relationship_profile: @relationship_profile, conversation_recaps: @conversation_recaps, selected_type: @timeline_type %>
  <%= render "mood_notes/section", relationship_profile: @relationship_profile, mood_notes: @mood_notes, selected_type: @timeline_type %>
  <%= render "timeline_entries/section", relationship_profile: @relationship_profile, selected_type: @timeline_type %>
  <%= render "memory_records/section", relationship_profile: @relationship_profile %>
  <% if @memory_extraction_enabled || @extracted_memories.any? || @conversation_recaps.any? { |recap| recap.extraction_status != "not_requested" } %>
  <%= render "extracted_memories/section",
      relationship_profile: @relationship_profile,
      conversation_recaps: @conversation_recaps,
      extracted_memories: @extracted_memories,
      selected_extracted_memory: @selected_extracted_memory %>
  <% end %>
  <% unless @relationship_profile.archived? %>
    <%= component "social_context_ledger",
      relationship_profile: @relationship_profile,
      notes: @social_context_notes,
      notes_pagy: @social_context_notes_pagy,
      new_note: @new_social_context_note,
      analysis_permission: @social_context_analysis_permission %>
  <% end %>
      <% end %>
      <%= component "profile_section", section: "about", expanded: profile_section_expanded?("about") do %>
<%= render "relationship_profiles/about" %>
      <% end %>
      <%= component "profile_section", section: "ideas", expanded: profile_section_expanded?("ideas") do %>
  <%= render "suggestions/section",
    relationship_profile: @relationship_profile,
    suggestions: @suggestions,
    selected_suggestion: @selected_suggestion,
    feedbacks: @suggestion_feedbacks,
    next_gesture_variation: @next_gesture_variation %>
  <%= render "relationship_personas/section", relationship_profile: @relationship_profile, relationship_persona: @relationship_persona unless @relationship_profile.professional? %>
  <% unless @relationship_profile.archived? %>
    <%= component "relationship_briefing_workspace",
      relationship_profile: @relationship_profile,
      briefing: @relationship_briefing,
      form_state: @relationship_briefing_form_state,
      private_notes_available: @briefing_private_notes_available,
      vault_items_available: @briefing_vault_items_available,
      vault_unlocked: @briefing_vault_unlocked %>
    <%= component "message_draft_workspace",
      relationship_profile: @relationship_profile,
      message_draft: @message_draft,
      revisions: @message_draft_revisions,
      revisions_pagy: @message_draft_revisions_pagy,
      context_categories: @message_context_categories,
      private_notes_available: @message_private_notes_available,
      vault_items_available: @message_vault_items_available,
      vault_unlocked: @message_vault_unlocked %>
    <% if !@relationship_profile.professional? || @relationship_profile.professional_gifts_allowed? %>
    <%= component "gift_recommendation_workspace",
      relationship_profile: @relationship_profile,
      recommendations: @gift_recommendations,
      permission: @gift_recommendation_permission,
      form_state: @gift_recommendation_form_state,
      private_notes_available: @gift_recommendation_private_notes_available,
      vault_items_available: @gift_recommendation_vault_items_available,
      vault_unlocked: @gift_recommendation_vault_unlocked %>
    <% end %>
  <% end %>
      <% end %>
      <%= component "profile_section", section: "privacy", expanded: profile_section_expanded?("privacy") do %>
  <%= render "privacy_vaults/section", relationship_profile: @relationship_profile %>
  <div class="workspace-actions">
    <% unless @relationship_profile.archived? %>
      <%= button_to t("relationship_profiles.show.archive"), archive_relationship_profile_path(@relationship_profile), method: :patch, class: "workspace-action workspace-action-secondary" %>
    <% end %>
    <%= button_to t("relationship_profiles.show.delete"), relationship_profile_path(@relationship_profile), method: :delete, form: { data: { turbo_confirm: t("relationship_profiles.show.delete_confirm") } }, class: "workspace-action border-danger-border bg-canvas text-danger-ink" %>
  </div>
      <% end %>
    </div>
  </div>
</div>
