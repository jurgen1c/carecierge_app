<section class="mt-8 border-t border-private-line pt-6" aria-labelledby="family-roster-title">
  <h2 id="family-roster-title" class="text-xl font-semibold text-ink"><%= t("family_spaces.roster") %></h2>
  <p class="mt-3 break-words text-ink"><%= @space.owner.email %> · <%= t("family_spaces.organizer") %></p>
  <ul class="mt-3 divide-y divide-private-line">
    <% @family_memberships.each do |member| %>
      <% next unless member.user_id || @space.owner_id == current_user.id %>
      <li class="py-4">
        <p class="break-words text-ink"><%= member.user&.email || member.invited_email %> · <%= t("family_spaces.types.#{member.relationship_type}") %></p>
        <% unless member.user_id %><p class="mt-1 text-sm text-quiet-note"><%= t("shared_spaces.expires", date: l(member.invitation_expires_at.to_date)) %></p><% end %>
        <% if member.user_id == current_user.id || @space.owner_id == current_user.id %>
          <details class="mt-2">
            <summary class="min-h-11 cursor-pointer font-semibold text-ink"><%= t(member.user_id == current_user.id ? "family_spaces.leave" : "family_spaces.remove") %></summary>
            <p class="max-w-2xl text-sm leading-6 text-quiet-note"><%= t("family_spaces.leave_hint") %></p>
            <%= form_with url: family_membership_path(member), method: :delete, class: "mt-3 space-y-3" do |form| %>
              <label class="flex min-h-11 items-start gap-3 text-ink"><%= check_box_tag :confirm_leave, "1", false, id: "confirm-leave-#{member.id}", required: true, class: "mt-1 size-5 rounded border-stone-300 text-primary" %><span><%= t("family_spaces.confirm_leave") %></span></label>
              <%= form.submit t(member.user_id == current_user.id ? "family_spaces.leave" : "family_spaces.remove"), class: "min-h-11 rounded-lg border border-danger-border px-4 py-2 font-semibold text-danger-ink hover:bg-danger-surface" %>
            <% end %>
          </details>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @space.owner_id == current_user.id %>
    <details class="mt-4">
      <summary class="min-h-11 cursor-pointer font-semibold text-ink"><%= t("family_spaces.invite") %></summary>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("family_spaces.invite_hint") %></p>
      <%= form_with scope: :family_membership, url: shared_relationship_space_family_memberships_path(@space), class: "mt-4 space-y-4" do |form| %>
        <div><%= form.label :invited_email, t("family_spaces.email"), class: "block font-semibold text-ink" %><%= form.email_field :invited_email, required: true, maxlength: 254, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 px-3 py-2 text-ink" %></div>
        <div><%= form.label :relationship_type, t("family_spaces.relationship"), class: "block font-semibold text-ink" %><%= form.select :relationship_type, FamilyMembership::RELATIONSHIP_TYPES.map { |type| [t("family_spaces.types.#{type}"), type] }, {}, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 px-3 py-2 text-ink" %></div>
        <%= form.submit t("family_spaces.invite"), class: "min-h-11 rounded-lg bg-primary px-4 py-2 font-semibold text-canvas hover:bg-primary-hover" %>
      <% end %>
    </details>
  <% end %>
</section>
