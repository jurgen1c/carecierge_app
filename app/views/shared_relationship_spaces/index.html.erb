<% disable_turbo_cache %>
<main class="mx-auto max-w-4xl px-4 py-8 sm:px-6" aria-labelledby="shared-spaces-title">
  <%= link_to t("shared_spaces.back"), dashboard_path, class: "inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4" %>
  <h1 id="shared-spaces-title" class="mt-4 text-3xl font-semibold text-ink"><%= t("shared_spaces.title") %></h1>
  <p class="mt-3 max-w-2xl leading-7 text-quiet-note"><%= t("shared_spaces.introduction") %></p>

  <%= render "family_invitations" %>
  <% if @invitations.any? %>
    <section class="mt-8 border-y border-private-line py-6" aria-labelledby="invitations-title">
      <h2 id="invitations-title" class="text-xl font-semibold text-ink"><%= t("shared_spaces.invitations") %></h2>
      <% @invitations.each do |invitation| %>
        <article class="py-4">
          <h3 class="break-words font-semibold text-ink"><%= invitation.title %></h3>
          <p class="mt-2 break-words text-quiet-note"><%= t("shared_spaces.invitation_from", email: invitation.owner.email) %></p>
          <p class="mt-2 text-sm leading-6 text-quiet-note"><%= t("shared_spaces.acceptance_rules") %></p>
          <div class="mt-3 flex flex-wrap gap-3">
            <%= button_to t("shared_spaces.accept"), accept_shared_relationship_space_path(invitation), class: "min-h-11 rounded-lg bg-primary px-4 py-2 font-semibold text-canvas hover:bg-primary-hover" %>
            <%= button_to t("shared_spaces.decline"), shared_relationship_space_path(invitation), method: :delete, params: { confirm_end: "1" }, class: "min-h-11 rounded-lg border border-private-line px-4 py-2 font-semibold text-ink hover:bg-surface" %>
          </div>
        </article>
      <% end %>
    </section>
  <% end %>

  <section class="mt-8" aria-labelledby="your-spaces-title">
    <h2 id="your-spaces-title" class="text-xl font-semibold text-ink"><%= t("shared_spaces.your_spaces") %></h2>
    <% if @spaces.empty? %><p class="mt-3 text-quiet-note"><%= t("shared_spaces.empty") %></p><% end %>
    <ul class="mt-3 divide-y divide-private-line">
      <% @spaces.each do |space| %>
        <li class="py-4">
          <%= link_to space.title, shared_relationship_space_path(space), class: "inline-flex min-h-11 max-w-full items-center break-words font-semibold text-primary underline underline-offset-4" %>
          <p class="text-sm text-quiet-note"><%= t(space.family? ? "family_spaces.mode" : space.active? ? "shared_spaces.active" : "shared_spaces.pending") %></p>
        </li>
      <% end %>
    </ul>
    <%== @pagy.series_nav if @pagy.pages > 1 %>
  </section>

  <%= render "new_family" %>
  <section class="mt-8 border-t border-private-line pt-6" aria-labelledby="invite-title">
    <h2 id="invite-title" class="text-xl font-semibold text-ink"><%= t("shared_spaces.invite") %></h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("shared_spaces.invite_hint") %></p>
    <%= form_with model: @new_space, class: "mt-5 space-y-5" do |form| %>
      <% if @new_space.errors.any? %><div role="alert" class="rounded-lg border border-danger-border bg-danger-surface p-4 text-danger-ink"><%= @new_space.errors.full_messages.to_sentence %></div><% end %>
      <div><%= form.label :title, t("shared_spaces.space_name"), class: "block font-semibold text-ink" %><%= form.text_field :title, required: true, maxlength: 120, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 px-3 py-2 text-ink" %></div>
      <div><%= form.label :invited_email, t("shared_spaces.partner_email"), class: "block font-semibold text-ink" %><%= form.email_field :invited_email, required: true, maxlength: 254, class: "mt-2 min-h-11 w-full rounded-lg border border-stone-300 px-3 py-2 text-ink" %></div>
      <%= form.submit t("shared_spaces.invite"), class: "min-h-11 rounded-lg bg-primary px-5 py-3 font-semibold text-canvas hover:bg-primary-hover" %>
    <% end %>
  </section>
</main>
