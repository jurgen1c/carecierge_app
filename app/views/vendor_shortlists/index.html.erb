<% disable_turbo_cache %>
<main aria-labelledby="vendor-shortlists-title" class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 lg:px-8">
  <header class="flex flex-col gap-4 border-b border-private-line pb-6 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 id="vendor-shortlists-title" class="text-3xl font-semibold text-ink"><%= t("vendor_shortlists.index.title") %></h1>
      <p class="mt-2 max-w-2xl text-base leading-7 text-quiet-note"><%= t("vendor_shortlists.index.body") %></p>
    </div>
    <%= link_to t("vendor_shortlists.index.create"), new_vendor_shortlist_path, class: "inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-canvas hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
  </header>

  <% if @vendor_shortlists.any? %>
    <ol class="divide-y divide-private-line">
      <% @vendor_shortlists.each do |shortlist| %>
        <li class="py-5">
          <%= link_to vendor_shortlist_path(shortlist), class: "group block rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" do %>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div class="min-w-0">
                <h2 class="break-words text-lg font-semibold text-ink group-hover:text-primary"><%= shortlist.title %></h2>
                <p class="mt-1 text-sm text-quiet-note">
                  <%= shortlist.relationship_profile.display_name %>
                  <% if shortlist.event_plan %> · <%= shortlist.event_plan.title %><% end %>
                </p>
              </div>
              <div class="text-sm text-quiet-note">
                <p><%= t("vendor_shortlists.index.option_count", count: shortlist.vendor_options.length) %></p>
                <% if shortlist.selected_option %><p class="mt-1 font-semibold text-primary"><%= t("vendor_shortlists.index.selected", vendor: shortlist.selected_option.vendor.name) %></p><% end %>
              </div>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <section aria-labelledby="vendor-shortlists-empty-title" class="py-10">
      <h2 id="vendor-shortlists-empty-title" class="text-xl font-semibold text-ink"><%= t("vendor_shortlists.index.empty_title") %></h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-quiet-note"><%= t("vendor_shortlists.index.empty_body") %></p>
      <%= link_to t("vendor_shortlists.index.create"), new_vendor_shortlist_path, class: "mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4" %>
    </section>
  <% end %>

  <% if @pagy.last > 1 %>
    <nav aria-label="<%= t("vendor_shortlists.pagination.label") %>" class="flex items-center justify-between border-t border-private-line py-5">
      <% if @pagy.previous %><%= link_to t("vendor_shortlists.pagination.previous"), url_for(request.query_parameters.merge("page" => @pagy.previous)), class: "min-h-11 rounded-lg px-4 py-3 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %><% else %><span></span><% end %>
      <span class="text-sm text-quiet-note"><%= t("vendor_shortlists.pagination.page", page: @pagy.page, pages: @pagy.last) %></span>
      <% if @pagy.next %><%= link_to t("vendor_shortlists.pagination.next"), url_for(request.query_parameters.merge("page" => @pagy.next)), class: "min-h-11 rounded-lg px-4 py-3 text-sm font-semibold text-primary hover:bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %><% end %>
    </nav>
  <% end %>

  <p class="border-t border-private-line pt-5 text-sm leading-6 text-quiet-note"><%= t("vendor_shortlists.review_only") %></p>
</main>
